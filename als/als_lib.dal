// ---- settings (Settings/*.h) ---------------------------------------------------------------------------------------
settings AlsViewSettings {                                                                              // AlsViewSettings.h:6
    bEnableNetworkSmoothing: bool = true;
    bEnableListenServerNetworkSmoothing: bool = true;
}
settings AlsMantlingTraceSettings {                                                                     // AlsMantlingSettings.h:80
    LedgeHeight: vec2 = vec2(50.0, 225.0);
    ReachDistance: float = 75.0;
    TargetLocationOffset: float = 15.0;
    StartLocationOffset: float = 55.0;
    bDrawFailedTraces: bool;
}
settings AlsGeneralMantlingSettings {                                                                   // AlsMantlingSettings.h:101
    bAllowMantling: bool = true;
    bAutoStartMantlingInAir: bool = true;
    TraceAngleThreshold: float = 110.0;
    MaxReachAngle: float = 50.0;
    SlopeAngleThreshold: float = 35.0;
    derived SlopeAngleThresholdCos: float = cos(deg_to_rad(SlopeAngleThreshold));       // recomputed after loading (AlsMantlingSettings.cpp:9)
    TargetPrimitiveSpeedThreshold: float = 10.0;
    MantlingHighHeightThreshold: float = 125.0;
    GroundedTrace: AlsMantlingTraceSettings;
    InAirTrace: AlsMantlingTraceSettings = AlsMantlingTraceSettings(LedgeHeight: vec2(50.0, 150.0), ReachDistance: 70.0);   // AlsMantlingSettings.h:128-131
    MantlingTraceChannel: Channel = Channel.Visibility;
    MantlingTraceResponseChannels: channel_set;
    MantlingTraceResponses: channel_set;                                                 // FCollisionResponseContainer in C++: here the channels that block (same data as ...ResponseChannels)
    BlendOutDuration: float = 0.3;
    bStartRagdollingOnTargetPrimitiveDestruction: bool = true;
}
settings AlsRagdollingSettings {                                                                        // AlsRagdollingSettings.h:8
    bStartRagdollingOnLand: bool = true;
    RagdollingOnLandSpeedThreshold: float = 1000.0;
    bLimitInitialRagdollSpeed: bool = true;
    GetUpFrontMontage: montage;
    GetUpBackMontage: montage;
}
settings AlsRollingSettings {                                                                           // AlsRollingSettings.h:8
    Montage: montage;
    bCrouchOnStart: bool = true;
    bRotateToInputOnStart: bool = true;
    RotationInterpolationHalfLife: float = 0.1;
    bStartRollingOnLand: bool = true;
    RollingOnLandSpeedThreshold: float = 700.0;
    bInterruptRollingWhenInAir: bool = true;
}
settings AlsCharacterSettings {                                                                         // AlsCharacterSettings.h:11
    TeleportDistanceThreshold: float = 50.0;
    MovingSpeedThreshold: float = 50.0;
    InAirRotationMode: AlsInAirRotationMode = AlsInAirRotationMode.RotateToVelocity;
    bAllowAimingWhenInAir: bool = true;
    bSprintHasPriorityOverAiming: bool;
    bRotateToVelocityWhenSprinting: bool;
    bInheritMovementBaseRotationInVelocityDirectionRotationMode: bool;
    bRotateTowardsDesiredVelocityInVelocityDirectionRotationMode: bool = true;
    bAutoRotateOnAnyInputWhileNotMovingInViewDirectionRotationMode: bool = true;
    AimingYawAngleLimit: float = 70.0;
    View: AlsViewSettings;
    Mantling: AlsGeneralMantlingSettings;
    Ragdolling: AlsRagdollingSettings;
    Rolling: AlsRollingSettings;
}
settings AlsMantlingSettings {                                                                          // AlsMantlingSettings.h:42: MS_Als_High, MS_Als_Low, ...: one mantling kind
    Montage: montage;
    bAutoCalculateStartTime: bool;
    StartTimeReferenceHeight: vec2 = vec2(50.0, 100.0);
    StartTime: vec2 = vec2(0.5, 0.0);
    MotionWarpingTimeRange: AlsFloatInterval = AlsFloatInterval(Min: 0.0, Max: 0.3);
    MotionWarpingLocationBlendOption: BlendOption = BlendOption.Linear;
    MotionWarpingLocationCustomBlendCurve: curve;
    MotionWarpingRotationBlendOption: BlendOption = BlendOption.HermiteCubic;
    MotionWarpingRotationCustomBlendCurve: curve;
}
settings AlsMovementGaitSettings {                                                                      // AlsMovementSettings.h:11
    bAllowDirectionDependentMovementSpeed: bool;
    WalkForwardSpeed: float = 175.0;
    WalkBackwardSpeed: float = 175.0;
    RunForwardSpeed: float = 375.0;
    RunBackwardSpeed: float = 375.0;
    SprintSpeed: float = 650.0;
    AccelerationAndDecelerationAndGroundFrictionCurve: curve3;                           // gait amount (0..3) -> (MaxAccelerationWalking, BrakingDecelerationWalking, GroundFriction)
    RotationInterpolationSpeedCurve: curve;                                              // gait amount (0..3) -> rotation interpolation half life
}
