struct AlsFootState {                                                                                   // AlsFeetState.h:6
    LockAmount: float;
    ThighAxisPelvisSpace: vec3;
    TargetLocationWorldSpace: vec3;
    TargetRotationWorldSpace: quat;
    LockLocationWorldSpace: vec3;
    LockRotationWorldSpace: quat;
    LockLocationMovementBaseSpace: vec3;
    LockRotationMovementBaseSpace: quat;
