// als_lib.dal -- the shared declarations of ALS-Refactored rewritten in DAL: tag sets, enums, state structs, settings types
// and the pure math helpers.  A library: no logic.  `use`d by AlsCharacter.dal, AlsInput.dal and the animation instance.
//
// ALS-Refactored (c) Sixze, MIT.  Source files (Plugins/ALS-Refactored/Source/ALS):
//   Public/Utility/{AlsGameplayTags,AlsMath,AlsRotation,AlsVector}.h, Private/Utility/{AlsMath,AlsVector}.cpp,
//   Public/State/*.h, Public/Settings/*.h.
// Names, members, order and defaults follow the C++ ones, so that a .dab reads Main.GroundedState.VelocityBlend... and the data
// assets exported from the project (CS_Als_Default, AIS_Als_Default, MS_Als_*) load into the settings types below.
//
// Differences from the C++ that cannot be written in DAL (each is a language gap recorded in als-dal-rewrite.md section 7):
//   * the collision response containers (MantlingTraceResponses, GroundPredictionSweepResponses, FCollisionResponseContainer in C++)
//     are channel lists here: the channels that block, which is what the exported container data says.  The data loads without a
//     warning; the two lists next to them (...ResponseChannels) hold the same channels.
//   * UAlsTurnInPlaceSettings is an Instanced UObject in C++ (null = not set); here it is a nested settings value.
//   * FAlsTurnInPlaceState::QueuedSettings is a copy of the settings value (C++: a pointer to the UAlsTurnInPlaceSettings object) and
//     QueuedSlotName is the enum AlsTurnInPlaceSlot (C++: an FName; None = nothing queued, which is what a null QueuedSettings says).
//   * FAlsRagdollingAnimationState::FinalRagdollPose is the `snapshot` value type (0.4.0), filled by host.snapshot_pose.
//   * the view network smoothing members of FAlsViewState and the movement base state of the character are not declared (no
//     networking, no moving bases).

// ---- gameplay tags (AlsGameplayTags.h:5-65, AlsGameplayTags.cpp) ----------------------------------------------------------
tags AlsViewMode          = "Als.ViewMode"          { FirstPerson, ThirdPerson }
tags AlsLocomotionMode    = "Als.LocomotionMode"    { Grounded, InAir }
tags AlsRotationMode      = "Als.RotationMode"      { VelocityDirection, ViewDirection, Aiming }
tags AlsStance            = "Als.Stance"            { Standing, Crouching }
tags AlsGait              = "Als.Gait"              { Walking, Running, Sprinting }
tags AlsOverlayMode       = "Als.OverlayMode"       { Default, Masculine, Feminine, Injured, HandsTied, Rifle, PistolOneHanded,
                                                      PistolTwoHanded, Bow, Torch, Binoculars, Box, Barrel }
tags AlsLocomotionAction  = "Als.LocomotionAction"  { Rolling, Mantling, Ragdolling, GettingUp }
tags AlsGroundedEntryMode = "Als.GroundedEntryMode" { FromRoll }

// ---- enums ------------------------------------------------------------------------------------------------------------
enum AlsHipsDirection { Forward, Backward, LeftForward, LeftBackward, RightForward, RightBackward }   // AlsGroundedState.h:7
enum AlsMovementDirection { Forward, Backward, Left, Right }                                           // AlsMovementDirection.h:6
enum AlsInAirRotationMode { KeepWorldRotation, KeepViewSpaceRotation, RotateToVelocity }              // AlsInAirRotationMode.h:6
enum AlsMantlingType { High, Low, InAir }                                                              // AlsMantlingSettings.h:13

// ---- shared small structs ------------------------------------------------------------------------------------------
struct AlsFloatInterval { Min: float; Max: float; }                                                    // FFloatInterval (Min, Max)

// ---- character state: AAlsCharacter's members (State/*.h) -------------------------------------------------------------
struct AlsLocomotionState {                                                                             // AlsLocomotionState.h:6
    bHasInput: bool;
    InputYawAngle: float;
    bHasVelocity: bool;
    Speed: float;
    Velocity: vec3;
    VelocityYawAngle: float;
    bMoving: bool;
    bRotationTowardsLastInputDirectionBlocked: bool = true;
    TargetYawAngle: float;
    SmoothTargetYawAngle: float;                                // used for extra-smooth actor rotation, else equal to TargetYawAngle
    TargetYawAngleViewSpace: float;
    AimingYawAngleLimit: float = 180.0;
    bAimingLimitAppliedThisFrame: bool;
    bResetAimingLimit: bool = true;
}
struct AlsViewState {                                                                                   // AlsViewState.h:36 (without NetworkSmoothing)
    Rotation: rotator;
    YawSpeed: float;
    PreviousYawAngle: float;
}
struct AlsMantlingState { RootMotionSourceId: int; }                                                    // AlsMantlingState.h:6
struct AlsRagdollingState {                                                                             // AlsRagdollingState.h:6
    Velocity: vec3;
    PullForce: float;
    SpeedLimitFrameTimeRemaining: int;
    SpeedLimit: float;
}
struct AlsRollingState { TargetYawAngle: float; }                                                       // AlsRollingState.h:6
struct AlsMantlingParameters {                                                                          // AlsMantlingSettings.h:21
    TargetPrimitive: primitive;
    TargetLocation: vec3;
    TargetRotation: rotator;
    MantlingHeight: float;
    MantlingType: AlsMantlingType;
}

// ---- animation state: the paths a .dab reads (State/*.h) ------------------------------------------------------------
struct AlsLocomotionAnimationState {                                                                    // AlsLocomotionAnimationState.h:6
    bHasInput: bool;
    InputYawAngleWorldSpace: float;
    Speed: float;
    VelocityWorldSpace: vec3;
    VelocityYawAngleWorldSpace: float;
    AccelerationWorldSpace: vec3;
    MaxAcceleration: float;
    MaxBrakingDeceleration: float;
    WalkableFloorAngleCos: float;
    bMoving: bool;
    bMovingSmooth: bool;
    TargetYawAngleWorldSpace: float;
    LocationWorldSpace: vec3;
    RotationWorldSpace: rotator;
    RotationQuaternionWorldSpace: quat;
    YawVelocityWorldSpace: float;
    ScaleWorldSpace: float = 1.0;
    CapsuleRadius: float;
    CapsuleHalfHeight: float;
}
struct AlsViewAnimationState {                                                                          // AlsViewAnimationState.h:6
    RotationWorldSpace: rotator;
    YawAngle: float;
    YawSpeed: float;
    PitchAngle: float;
    PitchAmount: float = 0.5;
    HeadBlendAmount: float = 1.0;
}
struct AlsSpineState {                                                                                  // AlsSpineState.h:6
    bSpineRotationAllowed: bool;
    SpineAmount: float;
    SpineAmountScale: float = 1.0;
    SpineAmountBias: float;
    LastYawAngle: float;
    LastYawAngleWorldSpace: float;
    YawAngle: float;
    FinalYawAngle: float;
}
struct AlsHeadState {                                                                                   // AlsHeadState.h:6
    bInitializationRequired: bool = true;
    bSwitchingLookSides: bool;
    PitchAngle: float;
    YawAngle: float;
    YawVelocity: float;
    YawAmount: float = 0.5;
}
struct AlsLeanState { RightAmount: float; ForwardAmount: float; }                                       // AlsLeanState.h:6
struct AlsLayeringState {                                                                               // AlsLayeringState.h:6
    HeadBlendAmount: float;
    HeadAdditiveBlendAmount: float;
    HeadSlotBlendAmount: float = 1.0;
    ArmLeftBlendAmount: float;
    ArmLeftAdditiveBlendAmount: float;
    ArmLeftSlotBlendAmount: float = 1.0;
    ArmLeftLocalSpaceBlendAmount: float;
    ArmLeftMeshSpaceBlendAmount: float;
    ArmRightBlendAmount: float;
    ArmRightAdditiveBlendAmount: float;
    ArmRightSlotBlendAmount: float = 1.0;
    ArmRightLocalSpaceBlendAmount: float;
    ArmRightMeshSpaceBlendAmount: float;
    HandLeftBlendAmount: float;
    HandRightBlendAmount: float;
    SpineBlendAmount: float;
    SpineAdditiveBlendAmount: float;
    SpineSlotBlendAmount: float = 1.0;
    PelvisBlendAmount: float;
    PelvisSlotBlendAmount: float = 1.0;
    LegsBlendAmount: float;
    LegsSlotBlendAmount: float = 1.0;
}
struct AlsPoseState {                                                                                   // AlsPoseState.h:6
    GroundedAmount: float = 1.0;
