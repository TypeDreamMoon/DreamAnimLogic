    bValid: bool;
    bBecameValid: bool;
    Left: AlsFootState = AlsFootState(ThighAxisPelvisSpace: vec3(0.0, 0.0, -1.0));
    Right: AlsFootState = AlsFootState(ThighAxisPelvisSpace: vec3(0.0, 0.0, 1.0));
}
struct AlsTransitionsState {                                                                            // AlsTransitionsState.h:8
    bTransitionsAllowed: bool;
    QueuedTransitionSequence: sequence = none;
    QueuedTransitionBlendInDuration: float;
    QueuedTransitionBlendOutDuration: float;
    QueuedTransitionPlayRate: float = 1.0;
    QueuedTransitionStartTime: float;
    bStopTransitionsQueued: bool;
    QueuedStopTransitionsBlendOutDuration: float = -1.0;
}
struct AlsDynamicTransitionsState { bUpdatedThisFrame: bool; FrameDelay: int; }                         // AlsDynamicTransitionsState.h:6
struct AlsRotateInPlaceState {                                                                          // AlsRotateInPlaceState.h:6
    bUpdatedThisFrame: bool;
    bRotatingLeft: bool;
    bRotatingRight: bool;
    PlayRate: float = 1.0;
}
struct AlsTurnInPlaceState {                                                                            // AlsTurnInPlaceState.h:8
    bUpdatedThisFrame: bool;
    ActivationDelay: float;
    QueuedSettings: AlsTurnInPlaceSettings;                                                             // a copy; only meaningful while QueuedSlotName is not None
    QueuedSlotName: AlsTurnInPlaceSlot;
