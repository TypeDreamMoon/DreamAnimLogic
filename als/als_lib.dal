// ---- math: Utility/AlsMath.h, AlsMath.cpp, AlsVector.h, AlsVector.cpp, AlsRotation.h ------------------------------------------
// The pure helpers.  The ones that are plain UE built-ins in the C++ (FMath::GetRangePct, UAlsRotation::GetTwist = get_twist,
// FQuat::FastLerp, UnwindDegrees ...) are the DAL built-ins of the same name.  Not here: UAlsMath::TryCalculatePoleVector and the
// spring-damper states (used by the Control Rig units only, which stay on the graph side).

const CounterClockwiseRotationAngleThreshold: float = 5.0;                                       // AlsRotation.h:12

fn clamp01(x: float) -> float { return x > 0.0 ? (x < 1.0 ? x : 1.0) : 0.0; }                    // AlsMath.h:70

fn lerp_clamped(a: float, b: float, ratio: float) -> float { return a + (b - a) * clamp01(ratio); }   // AlsMath.h:79

fn damper_exact_alpha(dt: float, half_life: float) -> float {                                    // AlsMath.h:84
    return 1.0 - inv_exp_approx(LN2 / (half_life + SMALL_NUMBER) * dt);
}

fn damper_exact(current: float, target: float, dt: float, half_life: float) -> float {          // AlsMath.h:91 (float)
    return lerp(current, target, damper_exact_alpha(dt, half_life));
}

fn damper_exact_vec2(current: vec2, target: vec2, dt: float, half_life: float) -> vec2 {         // AlsMath.h:91 (FVector2D)
    return lerp(current, target, damper_exact_alpha(dt, half_life));
}

fn damper_exact_vec3(current: vec3, target: vec3, dt: float, half_life: float) -> vec3 {         // AlsMath.h:91 (FVector)
    return lerp(current, target, damper_exact_alpha(dt, half_life));
}

fn calculate_movement_direction(angle: float, forward_half_angle: float, angle_threshold: float) -> AlsMovementDirection {   // AlsMath.cpp:11
    if (angle >= -forward_half_angle - angle_threshold && angle <= forward_half_angle + angle_threshold) {
        return AlsMovementDirection.Forward;
    }
    if (angle >= forward_half_angle - angle_threshold && angle <= 180.0 - forward_half_angle + angle_threshold) {
        return AlsMovementDirection.Right;
    }
    if (angle <= -(forward_half_angle - angle_threshold) && angle >= -(180.0 - forward_half_angle + angle_threshold)) {
        return AlsMovementDirection.Left;
    }
    return AlsMovementDirection.Backward;
}

fn clamp_magnitude01(v: vec3) -> vec3 {                                                          // AlsVector.h:86
    let magnitude_sq = length_sq(v);
    if (magnitude_sq <= 1.0) { return v; }
    return v * inv_sqrt(magnitude_sq);
}

fn clamp_magnitude01_2d(v: vec2) -> vec2 {                                                       // AlsVector.h:114
    let magnitude_sq = length_sq(v);
    if (magnitude_sq <= 1.0) { return v; }
    return v * inv_sqrt(magnitude_sq);
}

fn radian_to_direction(radian: float) -> vec2 { return vec2(cos(radian), sin(radian)); }         // AlsVector.h:128

fn radian_to_direction_xy(radian: float) -> vec3 { return vec3(cos(radian), sin(radian), 0.0); } // AlsVector.h:136

fn angle_to_direction(angle: float) -> vec2 { return radian_to_direction(deg_to_rad(angle)); }  // AlsVector.h:144

fn angle_to_direction_xy(angle: float) -> vec3 { return radian_to_direction_xy(deg_to_rad(angle)); }   // AlsVector.h:149

fn direction_to_angle(d: vec2) -> float { return rad_to_deg(atan2(d.y, d.x)); }                  // AlsVector.h:154

fn direction_to_angle_xy(d: vec3) -> float { return rad_to_deg(atan2(d.y, d.x)); }               // AlsVector.h:159

fn perpendicular_clockwise_xy(v: vec3) -> vec3 { return vec3(v.y, -v.x, v.z); }                  // AlsVector.h:164

fn perpendicular_counter_clockwise_xy(v: vec3) -> vec3 { return vec3(-v.y, v.x, v.z); }          // AlsVector.h:169

fn angle_between_skip_normalization(a: vec3, b: vec3) -> float { return rad_to_deg(acos(dot(a, b))); }   // AlsVector.h:174

fn angle_between_signed_xy(a: vec3, b: vec3) -> float {                                          // AlsVector.h:179
    let from_xy = normalize(a.xy);
    let to_xy = normalize(b.xy);
    let cross_z = from_xy.x * to_xy.y - from_xy.y * to_xy.x;                                     // FVector2f operator^
    return rad_to_deg(acos(dot(from_xy, to_xy))) * sign(cross_z);
}

fn slerp_skip_normalization(a: vec3, b: vec3, ratio: float) -> vec3 {                            // AlsVector.cpp:7
    let d = dot(a, b);
    if (d > 0.9995) { return normalize(lerp(a, b, ratio)); }
    let clamped = max(-1.0, d);
    let theta = acos(clamped) * ratio;
    let perpendicular = normalize(b - a * clamped);                                              // FromPerpendicular.Normalize(), zero when it cannot be normalized
    return a * cos(theta) + perpendicular * sin(theta);
}

fn remap_angle_for_counter_clockwise_rotation(angle: float) -> float {                           // AlsRotation.h:51
    if (angle > 180.0 - CounterClockwiseRotationAngleThreshold) { return angle - 360.0; }
    return angle;
}

fn lerp_angle(a: float, b: float, ratio: float) -> float {                                       // AlsRotation.h:83
    let delta = remap_angle_for_counter_clockwise_rotation(unwind_degrees(b - a));
    return unwind_degrees(a + delta * ratio);
}

fn lerp_rotation(a: rotator, b: rotator, ratio: float) -> rotator {                              // AlsRotation.h:91 (the vector-intrinsics path, which every desktop build takes)
    let d = delta_rotator(b, a);                                                                 // (b - a).GetNormalized()
    if (abs(d.pitch) <= KINDA_SMALL_NUMBER && abs(d.yaw) <= KINDA_SMALL_NUMBER && abs(d.roll) <= KINDA_SMALL_NUMBER) { return b; }
    let pitch = d.pitch >= 180.0 - CounterClockwiseRotationAngleThreshold ? d.pitch - 360.0 : d.pitch;   // RemapRotationForCounterClockwiseRotation :62 (>=)
    let yaw = d.yaw >= 180.0 - CounterClockwiseRotationAngleThreshold ? d.yaw - 360.0 : d.yaw;
    let roll = d.roll >= 180.0 - CounterClockwiseRotationAngleThreshold ? d.roll - 360.0 : d.roll;
    return normalize_rotator(rotator(a.pitch + pitch * ratio, a.yaw + yaw * ratio, a.roll + roll * ratio));
}

fn interpolate_angle_constant(current: float, target: float, dt: float, speed: float) -> float { // AlsRotation.h:130
    var delta = unwind_degrees(target - current);
    let max_delta = speed * dt;
    if (speed <= 0.0 || abs(delta) <= max_delta) { return target; }
    delta = remap_angle_for_counter_clockwise_rotation(delta);
    return unwind_degrees(current + sign(delta) * max_delta);
}

fn damper_exact_angle(current: float, target: float, dt: float, half_life: float) -> float {    // AlsRotation.h:144
    var delta = unwind_degrees(target - current);
    if (is_nearly_zero(delta, KINDA_SMALL_NUMBER)) { return target; }
    delta = remap_angle_for_counter_clockwise_rotation(delta);
    return unwind_degrees(current + delta * damper_exact_alpha(dt, half_life));
}

fn damper_exact_rotation(current: rotator, target: rotator, dt: float, half_life: float) -> rotator {   // AlsRotation.h:159 (vector-intrinsics path)
    let d = delta_rotator(target, current);
    if (abs(d.pitch) <= KINDA_SMALL_NUMBER && abs(d.yaw) <= KINDA_SMALL_NUMBER && abs(d.roll) <= KINDA_SMALL_NUMBER) { return target; }
    let pitch = d.pitch >= 180.0 - CounterClockwiseRotationAngleThreshold ? d.pitch - 360.0 : d.pitch;
    let yaw = d.yaw >= 180.0 - CounterClockwiseRotationAngleThreshold ? d.yaw - 360.0 : d.yaw;
    let roll = d.roll >= 180.0 - CounterClockwiseRotationAngleThreshold ? d.roll - 360.0 : d.roll;
    let alpha = damper_exact_alpha(dt, half_life);
    return normalize_rotator(rotator(current.pitch + pitch * alpha, current.yaw + yaw * alpha, current.roll + roll * alpha));
}

fn interpolate_quaternion_fast(current: quat, target: quat, dt: float, speed: float) -> quat {  // AlsRotation.h:210
    let equal = abs(current.x - target.x) <= KINDA_SMALL_NUMBER && abs(current.y - target.y) <= KINDA_SMALL_NUMBER
             && abs(current.z - target.z) <= KINDA_SMALL_NUMBER && abs(current.w - target.w) <= KINDA_SMALL_NUMBER;   // FQuat::Equals
    if (speed <= 0.0 || equal) { return target; }
    return normalize(fast_lerp(current, target, clamp01(speed * dt)));
}

fn get_max_walk_speed(gait: AlsMovementGaitSettings) -> float {                                  // AlsMovementSettings.h:85 FAlsMovementGaitSettings::GetMaxWalkSpeed
    return gait.bAllowDirectionDependentMovementSpeed ? max(gait.WalkForwardSpeed, gait.WalkBackwardSpeed) : gait.WalkForwardSpeed;
}

fn get_max_run_speed(gait: AlsMovementGaitSettings) -> float {                                   // AlsMovementSettings.h:92 FAlsMovementGaitSettings::GetMaxRunSpeed
    return gait.bAllowDirectionDependentMovementSpeed ? max(gait.RunForwardSpeed, gait.RunBackwardSpeed) : gait.RunForwardSpeed;
}

// ================================================================================================================================
// Helpers of the animation instance (AlsAnimationInstance*.dal) go below this line, each with the ALS file:line it ports.
// ================================================================================================================================

// ---- additions for the anim instance ----------------------------------------------------------------------------------------
const ZERO_ANIMWEIGHT_THRESH: float = 0.00001;                                                    // Math/VectorRegister.h:133, the epsilon of FAnimWeight

fn is_full_weight(weight: float) -> bool { return weight >= 1.0 - ZERO_ANIMWEIGHT_THRESH; }        // FAnimWeight::IsFullWeight (AnimTypes.h:672)

fn is_relevant(weight: float) -> bool { return weight > ZERO_ANIMWEIGHT_THRESH; }                  // FAnimWeight::IsRelevant (AnimTypes.h:666)

fn movement_direction_cache(d: AlsMovementDirection) -> AlsMovementDirectionCache {               // AlsMovementDirection.h:25 FAlsMovementDirectionCache(EAlsMovementDirection)
    return AlsMovementDirectionCache(bForward: d == AlsMovementDirection.Forward, bBackward: d == AlsMovementDirection.Backward,
                                     bLeft: d == AlsMovementDirection.Left, bRight: d == AlsMovementDirection.Right);
}

// ---- foot lock and turn in place (AlsAnimationInstance.dal) ------------------------------------------------------------------
enum AlsTurnInPlaceSlot { None, TurnInPlaceStanding, TurnInPlaceCrouching }                      // the FName slots of UAlsConstants (AlsConstants.h:30-31); None = nothing queued

struct AlsFootUpdateContext {                                                                      // FAlsFootUpdateContext (AlsFeetState.h:76); the foot itself is passed next to it
    ComponentTransform: transform;
    ComponentTransformInverse: transform;
    IkAmount: float;
    LockAmount: float;
    FrameTime: float;
}

// FTransform::EqualsNoScale(FTransform::Identity) with the default tolerance, as AlsAnimationInstance.cpp:1263 asks it: FQuat::Equals is true for q and -q.
fn is_identity_no_scale(t: transform) -> bool {
    let q = t.rotation;
    let l = t.location;
    let same = abs(q.x) <= KINDA_SMALL_NUMBER && abs(q.y) <= KINDA_SMALL_NUMBER && abs(q.z) <= KINDA_SMALL_NUMBER && abs(q.w - 1.0) <= KINDA_SMALL_NUMBER;
    let opposite = abs(q.x) <= KINDA_SMALL_NUMBER && abs(q.y) <= KINDA_SMALL_NUMBER && abs(q.z) <= KINDA_SMALL_NUMBER && abs(q.w + 1.0) <= KINDA_SMALL_NUMBER;
    return (same || opposite) && abs(l.x) <= KINDA_SMALL_NUMBER && abs(l.y) <= KINDA_SMALL_NUMBER && abs(l.z) <= KINDA_SMALL_NUMBER;
}
