// AlsCharacter.dal -- AAlsCharacter (AlsCharacter.h / AlsCharacter.cpp) and the part of UAlsCharacterMovementComponent that is ALS's own
// logic (AlsCharacterMovementComponent.cpp: the gait settings and the grounded movement settings) rewritten in DAL.
//
// ALS-Refactored (c) Sixze, MIT.  Source: Plugins/ALS-Refactored/Source/ALS/Private/AlsCharacter.cpp (C below),
// AlsCharacter_Actions.cpp (CA), AlsCharacterMovementComponent.cpp (CMC), Public/AlsCharacter.h.  Every method carries the file:line
// of the C++ it ports; names, members and the order of the calls follow the C++ (names of the C++ functions in snake_case, `pub` ones
// as in the C++).  The animation instance copies the state of this logic (peer reads) and calls Jump() on its peer.
//
// In (milestones M1 and M3): the desired and the actual states (view mode, rotation mode, stance, gait, overlay mode, locomotion mode,
// locomotion action), the view, the input direction, the locomotion state, gait selection and the max allowed gait, rotation (grounded,
// in air, aiming, with the animation curves RotationYawSpeed / RotationYawOffset), the landing friction, jumping, the push of the
// gait settings to the movement component (CMC:894-1020), and the actions of AlsCharacter_Actions.cpp:
//   * rolling (CA:22-139): start conditions and direction, the montage, the rotation towards the target yaw while rolling;
//   * mantling (CA:141-713, RMS:37-128): the forward / downward traces and overlaps, the selection of the mantling settings, the start time,
//     the root motion source as a driver in the prepare_root_motion block (root_motion_override + the custom movement mode), stopping;
//     the target in the space of a moving primitive and the base the character stands on while it climbs;
//   * ragdolling (CA:717-1170): start (on request, on a hard landing), the refresh (pelvis, capsule snap, motor strength, speed limit), stop
//     and the get up montage chosen by the facing of the ragdoll, the FinalRagdollPose handshake with the animation instance;
//   * the three notify states the actions end on: SetLocomotionAction, SetRootMotionScale and EarlyBlendOut (Notifies/*).
//
// The movement base (a moving platform, an elevator, a vehicle the character stands on) is in: RefreshMovementBase and every
// `MovementBase.bHasRelativeLocation / bHasRelativeRotation` branch of the Refresh* functions, the mantling target in the space of its
// primitive and SetBase on it.  Whether the character's facing and view follow a turning base is the movement component's setting
// bIgnoreBaseRotation (true in ALS: they do not); with it off the branches that keep the view in the space of the base are the ones that run.
//
// Dropped for good (single player): everything that replicates (Server* / Client* / Multicast* / OnRep_*, view network
// smoothing, the network branches of RefreshLocomotion), RefreshMeshProperties (mesh tick options, with its absolute mesh rotation on a
// rotating base), the DisplayDebug family, the
// BlueprintImplementableEvents (OnGaitChanged, OnMantlingStarted, OnRagdollingEnded ...: language gap G19) and the extension points
// RefreshCustom*Rotation.
//
// Differences that follow from DAL (each one is listed in als-dal-rewrite.md section 7):
//   * the hooks of the engine (OnMovementModeChanged, OnStartCrouch / OnEndCrouch, OnJumped, PhysicsRotation) and the notify states of the
//     montages are `on` handlers, and the logic is `sync_events`: the event is handled when the movement component / the animation raises it, in
//     the middle of its tick, which is the order of the C++ (the hook ran inside the movement component, before AAlsCharacter::Tick, and the
//     animation instance of the same step already sees the stance OnStartCrouch has set or the action a branching point notify has ended).
//     A host that cannot push events (the Blender one) lets the logic poll them: `slot_events` handles them at the start of the next tick slot;
//   * the host commands run after the update block, so what the C++ does to the actor and reads back at once is mirrored in this logic's
//     state: SetActorRotation in ActorRotationNow, SetMovementMode and the OnMovementModeChanged call inside it (the locomotion mode) in
//     MovementModeNow / LocomotionMode; both mirrors are taken from the host again at the start of the next after_movement block;
//   * the movement component keeps a copy of the rotation mode, the stance and the gait settings: here they are this logic's own
//     RotationMode / Stance and the settings are looked up where they are used;
//   * RefreshGroundedMovementSettings runs inside PhysWalking in UE (with the velocity at the start of the movement, after OnStartCrouch / a
//     landing of the same step): the `physics_walking` block is that, run by the movement component of a host that has a walking physics of its
//     own (a hook slot).  A host without it never runs the block and push_movement_settings() at the end of the after_movement block pushes the
//     same settings with the velocity at the end of the movement, which is the same value one frame later;
//   * a data asset cannot be handed around in DAL, so SelectMantlingSettings (a Blueprint event in ALS) is the enum AlsMantlingSettingsKind
//     and views that read the selected asset's members out of the `param`s MantlingHigh ... (see als/bindings.json for the data assets);
//   * the physics of a ragdoll (bodies, joints, motors, the pelvis body) belong to the host's ragdoll service: ragdoll_begin / _end /
//     _limit_speed / _set_motor_strength; this logic keeps what ALS keeps in the character (when to start and stop, the speed limit frames,
//     the capsule on the ground, the get up montage).

use "als_lib.dal";

peer Anim: AlsAnimationInstance;                       // AlsCharacter.h:57 AnimationInstance: Jump() and SnapshotFinalRagdollPose() are called on it (queued)
logic AlsCharacter : actor slot_events sync_events in after_movement;   // the ALS Tick runs after the movement component (als-dal-rewrite.md 1.9)

param Settings: AlsCharacterSettings;                  // AlsCharacter.h:31
param MovementSettings: AlsMovementSettings;           // AlsCharacter.h:34

// The mantling settings AlsCharacter::SelectMantlingSettings (CA:577, overridden in B_Als_Character) chooses from, one param per data asset.
param MantlingHigh: AlsMantlingSettings;               // MS_Als_High
param MantlingHighInAir: AlsMantlingSettings;          // MS_Als_High_InAir
param MantlingLow: AlsMantlingSettings;                // MS_Als_Low
param MantlingLowBox: AlsMantlingSettings;             // MS_Als_Low_Box

// ---- what the host tells us, sampled at the start of every update block ---------------------------------------------------------
input WorldTime: double <- host.time;                                             // GetWorld()->GetTimeSeconds() (double): the time of a teleport goes to the animation instance   C:158
input Velocity: vec3 <- host.velocity;                                           // GetVelocity()                            C:1376
input Acceleration: vec3 <- host.acceleration;                                   // CMC->GetCurrentAcceleration()            C:1119
input MaxAcceleration: float <- host.max_acceleration;                           // CMC->GetMaxAcceleration()                C:1119 (the ground value on the ground, CMC:292)
input PrePenetrationVelocity: vec3 <- host.pre_penetration_velocity;             // TryConsumePrePenetrationAdjustmentVelocity, consumed by the read   C:1402
input PrePenetrationVelocityValid: bool <- host.pre_penetration_velocity_valid;
input ControlRotation: rotator <- host.control_rotation;                         // Super::GetViewRotation()                 C:101, C:1252
input ActorLocation: vec3d <- host.actor_location;                               // GetActorLocation() (FVector, double)     CA:174
input ActorRotation: quat <- host.actor_rotation;                                // GetActorRotation()                       C:110
input ActorQuat: quatd <- host.actor_rotation;                                   // GetActorQuat() (FQuat, double): the mantling reads it at double precision   CA:517, RMS:123
input IsGrounded: bool <- host.is_grounded;                                      // IsMovingOnGround()                       CMC:333 (PhysWalking only runs on the ground)
input CharacterMovementMode: MovementMode <- host.movement_mode;                 // GetCharacterMovement()->MovementMode     (MovementModeNow is taken from it at the start of the Tick)
input HasAnyRootMotion: bool <- host.has_root_motion;                            // HasAnyRootMotion()                       C:1521
input RootMotionModeOfAnimation: RootMotionMode <- host.root_motion_mode;        // GetAnimInstance()->RootMotionMode        CA:106
input CapsuleRadius: float <- host.capsule_radius;                               // GetCapsuleComponent()->GetScaledCapsuleRadius()      CA:209
input CapsuleHalfHeight: float <- host.capsule_half_height;                      // GetCapsuleComponent()->GetScaledCapsuleHalfHeight()  CA:210
input CapsuleScale: double <- host.actor_scale;                                  // GetCapsuleComponent()->GetComponentScale().Z (double)  CA:208
input MeshWorldTransform: transformd <- host.mesh_world_transform;                // GetMesh()->GetComponentTransform(): GetBaseRotationOffset() is the actor's rotation to it   CA:517
input RagdollSupported: bool <- host.ragdoll_supported;                          // the mesh has the pelvis and spine_03 bodies  CA:720-722
input PelvisTransform: transform <- host.bone_world_transform("pelvis");         // GetMesh()->GetSocketTransform(PelvisBoneName)  CA:1078 (AlsConstants.h: "pelvis"): where the ragdoll starts, and its yaw when it stops
input RagdollPelvisLocation: vec3d <- host.ragdoll_pelvis_location;               // the pelvis body of the ragdoll: FPhysicsInterface::GetTransform_AssumesLocked(..).GetLocation()  CA:883
input RagdollVelocity: vec3 <- host.ragdoll_velocity;                            // the pelvis body: FPhysicsInterface::GetLinearVelocity_AssumesLocked(..)  CA:884
input RagdollFacingUp: bool <- host.ragdoll_facing_up;                           // FMath::UnwindDegrees(PelvisRotation.Roll) <= 0.0f of the pelvis bone  CA:1099
input RotationYawSpeedCurve: float <- host.anim_curve("RotationYawSpeed");       // GetCurveValue(RotationYawSpeedCurveName) C:1814 (AlsConstants.h:81)
input RotationYawOffsetCurve: float <- host.anim_curve("RotationYawOffset");     // GetCurveValue(RotationYawOffsetCurveName) C:1650
// the based movement of the character (BasedMovement, AAlsCharacter::RefreshMovementBase C:403-428)
input BaseComponent: primitive <- host.movement_base;                            // BasedMovement.MovementBaseInterfaceData
input BaseLocation: vec3d <- host.movement_base_location;                        // MovementBaseUtility::GetMovementBaseTransform
input BaseRotation: quatd <- host.movement_base_rotation;
input BaseHasRelativeLocation: bool <- host.movement_base_has_relative_location; // BasedMovement.HasRelativeLocation()
input BaseRelativeRotation: bool <- host.movement_base_relative_rotation;        // BasedMovement.bRelativeRotation

// ---- state: AlsCharacter.h:36-110 and the members of the movement component the logic reads (AlsCharacterMovementComponent.h:93-105) ------
state bDesiredAiming: bool;                                                      // :38
state DesiredRotationMode: AlsRotationMode = AlsRotationMode.ViewDirection;      // :41
state DesiredStance: AlsStance = AlsStance.Standing;                             // :44
state DesiredGait: AlsGait = AlsGait.Running;                                    // :47
state ViewMode: AlsViewMode = AlsViewMode.ThirdPerson;                           // :50
state OverlayMode: AlsOverlayMode = AlsOverlayMode.Default;                      // :54
state LocomotionMode: AlsLocomotionMode = AlsLocomotionMode.Grounded;            // :60
state RotationMode: AlsRotationMode = AlsRotationMode.ViewDirection;             // :63 (the movement component's copy is the same value)
state Stance: AlsStance = AlsStance.Standing;                                    // :66 (idem)
state Gait: AlsGait = AlsGait.Walking;                                           // :69
state LocomotionAction: AlsLocomotionAction;                                     // :72 (no tag: no action)
state ReplicatedViewRotation: rotator;                                           // :81 (the raw view rotation, normalized)
state ViewState: AlsViewState;                                                   // :84
state InputDirection: vec3;                                                      // :87
state DesiredVelocityYawAngle: float;                                            // :91
state bHasDesiredVelocity: bool;                                                 // :94
state MovementBase: AlsMovementBaseState;                                        // AlsCharacter.h: the base the character stands on, as of the last RefreshMovementBase
state LocomotionState: AlsLocomotionState;                                       // :97
state MantlingState: AlsMantlingState;                                           // :100
state RagdollTargetLocation: vec3d;                                               // :103 (replicated in ALS; here the pelvis position the capsule follows)
state RagdollingState: AlsRagdollingState;                                       // :106
state RollingState: AlsRollingState;                                             // :109
state MaxAllowedGait: AlsGait = AlsGait.Running;                                 // CMC.h:102
state GaitAmount: float;                                                         // CMC.h:105

// ---- bookkeeping of this rewrite -----------------------------------------------------------------------------------------------
state ActorRotationNow: rotator;                                                 // GetActorRotation() as this update has changed it (host commands run after the block)
state bPhysicsWalkingRan: bool;                                                 // the host ran the physics_walking block since the last after_movement block (the settings are pushed already)
state bActorRotationMirrored: bool;                                              // ActorRotationNow was set by a hook handler: the block that follows keeps it
state NewActorRotation: rotator;                                                 // the `FRotator& ActorRotation` that ConstrainAimingRotation edits (C:1680, C:1718)
state MovementModeNow: MovementMode;                                             // GetCharacterMovement()->MovementMode, including the set_movement_mode calls of this block (host commands run after it)
state MantlingSource: AlsMantlingRootMotionSource;                               // the FAlsRootMotionSource_Mantling the movement component would hold (RMS.h)
state MantlingSourceCount: int;                                                  // the ids ApplyRootMotionSource hands out (MantlingState.RootMotionSourceId)
state AnimRootMotionTranslationScale: float = 1.0;                               // Character->GetAnimRootMotionTranslationScale(), as the SetRootMotionScale notify state left it
timer BrakingFrictionFactorResetTimer = 0.5;                                     // C:538-544 (ResetDelay)

// ---- types of the actions --------------------------------------------------------------------------------------------------------
// The data assets SelectMantlingSettings (a Blueprint event in ALS, CA:577) returns: this enum names the param that holds the asset.
enum AlsMantlingSettingsKind { High, HighInAir, Low, LowBox }

// FAlsRootMotionSource_Mantling (RootMotionSources/AlsRootMotionSource_Mantling.h) with what PrepareRootMotion reads: the source's own
// clock (FRootMotionSource::Time / Duration), the settings it was made with, and where it moves the actor from and to.
struct AlsMantlingRootMotionSource {
    bActive: bool;                                    // the movement component still holds the source (GetRootMotionSourceByID != nullptr)
    bClearPending: bool;                              // the source finished in the last tick: the root motion override ends before the next one
    Kind: AlsMantlingSettingsKind;                    // MantlingSettings
    Montage: montage;                                 // MantlingSettings->Montage
    MotionWarpingTimeRange: AlsFloatInterval;         // MantlingSettings->MotionWarpingTimeRange
    TargetPrimitive: primitive;
    Time: float;                                      // FRootMotionSource::GetTime()
    Duration: float;                                  // FRootMotionSource::GetDuration()
    MontageStartTime: float;
    StartLocation: vec3d;                             // FVector, FRotator: the engine's double types
    StartRotation: rotatord;
    TargetLocation: vec3d;
    TargetRotation: rotatord;
    MeshRotationOffset: quatd = quatd(0d, 0d, 0d, 1d);     // Character.GetBaseRotationOffset() (FQuat)
}

// The members of a UAlsMantlingSettings the start of a mantle reads (all but the two custom blend curves, which are read where they are used).
struct AlsMantlingSettingsValues {
    Montage: montage;
    bAutoCalculateStartTime: bool;
    StartTimeReferenceHeight: vec2;
    StartTime: vec2;
    MotionWarpingTimeRange: AlsFloatInterval;
}

const MIN_FLOOR_DIST: float = 1.9;                    // UCharacterMovementComponent::MIN_FLOOR_DIST
const MAX_FLOOR_DIST: float = 2.4;                    // UCharacterMovementComponent::MAX_FLOOR_DIST

// ================================================================================================================================
// helpers
// ================================================================================================================================

fn rotators_equal(a: rotator, b: rotator) -> bool {                              // FRotator::Equals with the default tolerance KINDA_SMALL_NUMBER (used by C:1132)
    let d = normalize_rotator(a - b);                                            // rotator arithmetic (0.4.0): the difference, each axis in (-180, 180]
    return abs(d.pitch) <= KINDA_SMALL_NUMBER && abs(d.yaw) <= KINDA_SMALL_NUMBER && abs(d.roll) <= KINDA_SMALL_NUMBER;
}

// SetActorRotation(Rotation, Teleport) as called at C:1715, C:1820, C:1901, C:1913, C:1923: the command runs after the block, the rest of the
// block sees the new rotation at once (GetActorRotation() after a SetActorRotation, C:1822, C:1928).
method set_actor_rotation_now(rotation: rotator, teleport: bool) {
    ActorRotationNow = normalize_rotator(rotation);                              // GetActorRotation() reads the (normalized) quaternion back
    host.set_actor_rotation(rotation, teleport);
}

// ================================================================================================================================
// lifecycle: PreRegisterAllComponents, BeginPlay
// ================================================================================================================================

on begin_play {                                                                  // C:92-118 PreRegisterAllComponents, C:137-181 BeginPlay
    // initial values, so that the animation instance reads the up-to-date state when it starts      C:94-115
    RotationMode = bDesiredAiming ? AlsRotationMode.Aiming : DesiredRotationMode;       // :97
    Stance = DesiredStance;                                                             // :98
    Gait = DesiredGait;                                                                 // :99
    ReplicatedViewRotation = normalize_rotator(ControlRotation);                        // :101 SetReplicatedViewRotation(Super::GetViewRotation().GetNormalized())
    ViewState.Rotation = ReplicatedViewRotation;                                        // :107
    ViewState.PreviousYawAngle = ViewState.Rotation.yaw;                                // :108
    ActorRotationNow = normalize_rotator(to_rotator(ActorRotation));
    set_target_yaw_angle(ActorRotationNow.yaw);                                         // :110-112
    LocomotionState.InputYawAngle = ActorRotationNow.yaw;                               // :114
    LocomotionState.VelocityYawAngle = ActorRotationNow.yaw;                            // :115
    MovementModeNow = CharacterMovementMode;                                            // the movement component's first mode is not a change
    // BeginPlay: update the states to use the initial desired values     C:168-178
    apply_desired_stance();                                                             // :170
    refresh_gait();                                                                     // :174 (the CMC copies of Stance / RotationMode :172, :178 are this logic's own)
    refresh_rotation_mode();                                                            // :176
    push_grounded_movement_settings();                                                  // the first PhysWalking would do it (CMC:335)
}

on timer BrakingFrictionFactorResetTimer {                                       // the timer lambda of C:540-544 (runs before the movement, like the timer manager)
    host.set_braking_friction_factor(0.0);                                       // C:543
}

// ================================================================================================================================
// the tick: AAlsCharacter::Tick, C:266-300
// ================================================================================================================================

// Nothing runs before the movement but the timers of this logic, which tick in its earliest slot: the timer manager of the engine fires
// them at the start of the frame, before the movement (BrakingFrictionFactorResetTimer).  The mantling used to be driven from here.
update(dt) in pre_movement {                                                     // C:538-544 (the timer lambda)
}

// The root motion source of the mantling is prepared where the movement component prepares its root motion sources (RMS:37): inside
// PerformMovement, after the character has followed its movement base, so the actor and the target primitive are where this step puts them.
// A hook slot: the movement component runs it itself, once per step, while the root motion override (the stand-in for the source) is
// there.  (AlsInput runs before this logic in its slot and declares `flush_peers`: the commands of its calls on this logic - Jump,
// SetDesiredStance, StartMantling ... - are handed to the host at the end of its own block, before the movement component runs.)
update(dt) in prepare_root_motion {
    prepare_mantling_root_motion(dt);                                            // FAlsRootMotionSource_Mantling::PrepareRootMotion, inside CharacterMovement->PerformMovement
}

update(dt) in after_movement {                                                   // C:266-300
    if (!bActorRotationMirrored) {                                               // the physics_rotation hook has rotated the actor already: the host has not applied it yet
        ActorRotationNow = normalize_rotator(to_rotator(ActorRotation));
    }
    bActorRotationMirrored = false;
    MovementModeNow = CharacterMovementMode;                                     // what the movement component has now (the hooks of the tick have been handled)

    if (MantlingSource.bClearPending) {                                          // the source finished in this step's PrepareRootMotion: the movement component removes it before the next one
        host.root_motion_clear();
        MantlingSource.bClearPending = false;
    }

    refresh_movement_base();                                                     // :277
    // RefreshMeshProperties();                                                  // :279 (mesh tick options)
    refresh_input();                                                             // :281
    refresh_locomotion_early();                                                  // :283
    refresh_view(dt);                                                            // :285
    refresh_locomotion();                                                        // :286
    refresh_gait();                                                              // :287
    refresh_rotation_mode();                                                     // :288
    refresh_rotation(dt);                                                        // :290
    auto_start_mantling();                                                       // :292
    refresh_mantling();                                                          // :293
    refresh_ragdolling(dt);                                                      // :294
    refresh_rolling(dt);                                                         // :295
    // Super::Tick(DeltaTime);                                                   // :297
    refresh_locomotion_late();                                                   // :299
    if (!bPhysicsWalkingRan) {
        push_movement_settings();                                                // CMC:335, see the header (a host without the physics_walking block)
    }
    bPhysicsWalkingRan = false;
}

// RefreshGroundedMovementSettings, the first thing PhysWalking does (CMC:333-335).  The movement component runs this block at that point (a hook
// slot), after it has handed the events of the step so far to the logic: the stance OnStartCrouch has just changed, the locomotion mode a landing
// has just set, with the velocity the walking move starts with.
update(dt) in physics_walking {
    push_grounded_movement_settings();
    bPhysicsWalkingRan = true;
}

// The overrides of the engine's hooks.  The movement component raises them while it moves the character, before AAlsCharacter::Tick, so
// `slot_events` handles them at the start of the after_movement slot of the same tick (the order of the C++).
on movement_mode_changed(previous_movement_mode, movement_mode) {                // C:469-491 OnMovementModeChanged
    apply_movement_mode(movement_mode);
}

// OnMovementModeChanged: use the character movement mode to set the locomotion mode to the right value.  This allows you to have a custom
// set of movement modes but still use the functionality of the default character movement component.
method apply_movement_mode(movement_mode: MovementMode) {                        // C:469-491 (GetCharacterMovement()->MovementMode is the new mode)
    MovementModeNow = movement_mode;
    if (movement_mode == MovementMode.Walking || movement_mode == MovementMode.NavWalking) {
        set_locomotion_mode(AlsLocomotionMode.Grounded);                         // :476-479
    } else if (movement_mode == MovementMode.Falling) {
        set_locomotion_mode(AlsLocomotionMode.InAir);                            // :481-483
    } else {
        set_locomotion_mode(AlsLocomotionMode.None);                             // :485-488
    }
}

// GetCharacterMovement()->SetMovementMode(Mode): the C++ runs OnMovementModeChanged inside the call, so the locomotion mode follows at once;
// the host command runs after this block and its hook finds nothing left to do.  (A locked movement mode ignores the call: the callers
// below set the mode before they lock it or after they unlock it.)
method set_movement_mode_now(movement_mode: MovementMode) {                      // C:469 + the SetMovementMode calls of CA:496, :708, :838, :1147, :1151
    host.set_movement_mode(movement_mode);
    apply_movement_mode(movement_mode);
}

on jumped {                                                                      // C:1473-1502 OnJumped_Implementation -> OnJumpedNetworked
    Anim.Jump();                                                                 // :1498-1501 (queued: the animation instance runs it at the start of its next update)
}

on crouch_started {                                                              // C:834-853 OnStartCrouch (the network smoothing patch :836-848 is dropped)
    set_stance(AlsStance.Crouching);                                             // :852
}

on crouch_ended {                                                                // C:855-871 OnEndCrouch (the network smoothing patch :857-866 is dropped)
    set_stance(AlsStance.Standing);                                              // :870
}

on teleported {                                                                  // C:153-160 the capsule's TransformUpdated with a TeleportType other than None
    Anim.MarkTeleportedAt(WorldTime);                                            // :158 (a call to the animation instance is queued and runs at the start of its next update, a frame later than the teleport
                                                                                 // when the movement component raises it after that update: the time of the teleport goes with it)
}

on physics_rotation(dt) {                                                        // C:1509-1512 CharacterMovement_OnPhysicsRotation, after UCharacterMovementComponent::PhysicsRotation
    ActorRotationNow = normalize_rotator(to_rotator(ActorRotation));
    refresh_rolling_physics(dt);                                                 // :1511
    bActorRotationMirrored = LocomotionAction == AlsLocomotionAction.Rolling;    // the tick that follows reads the rotation the hook has set (GetActorRotation() after PhysicsRotation)
}

// ================================================================================================================================
// view mode, aiming, rotation mode, stance, gait, overlay mode, locomotion mode, locomotion action
// ================================================================================================================================

pub method SetViewMode(NewViewMode: AlsViewMode) {                               // C:430-467 (the role check and the RPCs are dropped)
    if (ViewMode == NewViewMode) { return; }
    ViewMode = NewViewMode;                                                      // :442
}

method set_locomotion_mode(new_locomotion_mode: AlsLocomotionMode) {            // C:493-503
    if (LocomotionMode != new_locomotion_mode) {
        let previous_locomotion_mode = LocomotionMode;
        LocomotionMode = new_locomotion_mode;
        notify_locomotion_mode_changed(previous_locomotion_mode);
    }
}

method notify_locomotion_mode_changed(previous_locomotion_mode: AlsLocomotionMode) {   // C:505-562
    apply_desired_stance();                                                      // :507

    if (LocomotionMode == AlsLocomotionMode.Grounded && previous_locomotion_mode == AlsLocomotionMode.InAir) {     // :509-510
        if (Settings.Ragdolling.bStartRagdollingOnLand && LocomotionState.Velocity.z <= -Settings.Ragdolling.RagdollingOnLandSpeedThreshold) {
            StartRagdolling();                                                   // :512-516
        } else if (Settings.Rolling.bStartRollingOnLand && LocomotionState.Velocity.z <= -Settings.Rolling.RollingOnLandSpeedThreshold) {
            // PlayRate 1.3 (:520)
            StartRolling(LocomotionState.bHasVelocity ? LocomotionState.VelocityYawAngle : unwind_degrees(ActorRotationNow.yaw), 1.3);   // :522-525
        } else {
            // Increase friction for a short period of time to prevent sliding on the ground after landing.      :529-544
            host.set_braking_friction_factor(LocomotionState.bHasInput ? 0.5 : 3.0);          // :531-536 (HasInput / NoInput factors)
            start(BrakingFrictionFactorResetTimer);                                           // :538-544 SetTimer(ResetDelay 0.5 s)

            // Block rotation towards the last input direction after landing to prevent legs from twisting into a spiral.    :546-549
            LocomotionState.bRotationTowardsLastInputDirectionBlocked = true;
        }
    } else if (LocomotionMode == AlsLocomotionMode.InAir && LocomotionAction == AlsLocomotionAction.Rolling
               && Settings.Rolling.bInterruptRollingWhenInAir) {                 // :552-554
        StartRagdolling();                                                       // :558 (if the character is rolling, then enable ragdolling)
    }
    // OnLocomotionModeChanged(PreviousLocomotionMode);                          // :561 (Blueprint event, gap G19)
}

pub method SetDesiredAiming(bNewDesiredAiming: bool) {                           // C:564-593
    if (bDesiredAiming == bNewDesiredAiming) { return; }
    bDesiredAiming = bNewDesiredAiming;                                          // :576
    // OnDesiredAimingChanged(!bDesiredAiming);                                  // :580 (Blueprint event)
}

pub method SetDesiredRotationMode(NewDesiredRotationMode: AlsRotationMode) {     // C:612-639
    if (DesiredRotationMode == NewDesiredRotationMode) { return; }
    DesiredRotationMode = NewDesiredRotationMode;                                // :624
}

method set_rotation_mode(new_rotation_mode: AlsRotationMode) {                   // C:651-663, with CMC:916-924 SetRotationMode merged (same value)
    if (RotationMode != new_rotation_mode) {
        RotationMode = new_rotation_mode;                                        // :659
        notify_rotation_mode_changed();                                          // :661
    }
}

method notify_rotation_mode_changed() {                                          // C:665-673
    // This prevents the actor from rotating in the last input direction after the rotation mode
    // has been changed and the actor is not moving at that moment.
    LocomotionState.bRotationTowardsLastInputDirectionBlocked = true;            // :670
}

method refresh_rotation_mode() {                                                 // C:675-758
    let aiming = bDesiredAiming || DesiredRotationMode == AlsRotationMode.Aiming;       // :677
    let sprinting = MaxAllowedGait == AlsGait.Sprinting;                                // :678 (CMC->GetMaxAllowedGait())

    if (ViewMode == AlsViewMode.FirstPerson) {                                          // :680
        if (LocomotionMode == AlsLocomotionMode.InAir) {                                // :682
            if (aiming && Settings.bAllowAimingWhenInAir) {
                set_rotation_mode(AlsRotationMode.Aiming);                              // :686
            } else {
                set_rotation_mode(AlsRotationMode.ViewDirection);                       // :690
            }
            return;
        }
        // Grounded and other locomotion modes.                                         :696
        if (aiming && (!sprinting || !Settings.bSprintHasPriorityOverAiming)) {
            set_rotation_mode(AlsRotationMode.Aiming);                                  // :700
        } else {
            set_rotation_mode(AlsRotationMode.ViewDirection);                           // :704
        }
        return;
    }

    // Third person and other view modes.                                               :710
    if (LocomotionMode == AlsLocomotionMode.InAir) {                                    // :712
        if (aiming && Settings.bAllowAimingWhenInAir) {
            set_rotation_mode(AlsRotationMode.Aiming);                                  // :716
        } else if (aiming) {
            set_rotation_mode(AlsRotationMode.ViewDirection);                           // :720
        } else {
            set_rotation_mode(DesiredRotationMode);                                     // :724
        }
        return;
    }

    // Grounded and other locomotion modes.                                             :730
    if (sprinting) {                                                                    // :732
        if (aiming && !Settings.bSprintHasPriorityOverAiming) {
            set_rotation_mode(AlsRotationMode.Aiming);                                  // :736
        } else if (Settings.bRotateToVelocityWhenSprinting) {
            set_rotation_mode(AlsRotationMode.VelocityDirection);                       // :740
        } else {
            set_rotation_mode(DesiredRotationMode);                                     // :744
        }
    } else {                                                                            // Not sprinting. :747
        if (aiming) {
            set_rotation_mode(AlsRotationMode.Aiming);                                  // :751
        } else {
            set_rotation_mode(DesiredRotationMode);                                     // :755
        }
    }
}

pub method SetDesiredStance(NewDesiredStance: AlsStance) {                       // C:760-789
    if (DesiredStance == NewDesiredStance) { return; }
    DesiredStance = NewDesiredStance;                                            // :772
    apply_desired_stance();                                                      // :788
}

method apply_desired_stance() {                                                  // C:801-825
    if (!valid(LocomotionAction)) {                                              // :803
        if (LocomotionMode == AlsLocomotionMode.Grounded) {                      // :805
            if (DesiredStance == AlsStance.Standing) {
                host.uncrouch();                                                 // :809
            } else if (DesiredStance == AlsStance.Crouching) {
                host.crouch();                                                   // :813
            }
        } else if (LocomotionMode == AlsLocomotionMode.InAir) {                  // :816
            host.uncrouch();                                                     // :818
        }
    } else if (LocomotionAction == AlsLocomotionAction.Rolling && Settings.Rolling.bCrouchOnStart) {   // :821
        host.crouch();                                                           // :823
    }
}

method set_stance(new_stance: AlsStance) {                                       // C:873-885, with CMC:926-934 SetStance merged (same value)
    if (Stance != new_stance) {
        Stance = new_stance;                                                     // :881
        // OnStanceChanged(PreviousStance);                                      // :883 (Blueprint event)
    }
}

pub method SetDesiredGait(NewDesiredGait: AlsGait) {                             // C:889-916
    if (DesiredGait == NewDesiredGait) { return; }
    DesiredGait = NewDesiredGait;                                                // :901
}

method set_gait(new_gait: AlsGait) {                                             // C:928-938
    if (Gait != new_gait) {
        Gait = new_gait;                                                         // :934
        // OnGaitChanged(PreviousGait);                                          // :936 (Blueprint event)
    }
}

method refresh_gait() {                                                          // C:942-958
    if (LocomotionMode != AlsLocomotionMode.Grounded) { return; }                // :944-947

    let max_allowed_gait = calculate_max_allowed_gait();                         // :949

    // Update the character max walk speed to the configured speeds based on the currently max allowed gait.
    MaxAllowedGait = max_allowed_gait;                                           // :953 CMC->SetMaxAllowedGait

    set_gait(calculate_actual_gait(max_allowed_gait));                           // :955-957 (a call inside the arguments of a call: 0.4.0)
}

view calculate_max_allowed_gait() -> AlsGait {                                   // C:960-977
    // The maximum gait the character is currently allowed to be in, determined by the desired gait, the rotation mode, the stance ...
    if (DesiredGait != AlsGait.Sprinting) { return DesiredGait; }                // :966-969
    if (can_sprint()) { return AlsGait.Sprinting; }                              // :971-974
    return AlsGait.Running;                                                      // :976
}

view calculate_actual_gait(max_allowed_gait: AlsGait) -> AlsGait {               // C:979-998
    // Calculated by the actual movement of the character, so it can differ from the desired gait or the max allowed gait.
    let gait_settings = MovementSettings.RotationModes[RotationMode].Stances[Stance];   // CMC:910-913 GaitSettings (the movement component's copy)
    if (LocomotionState.Speed < get_max_walk_speed(gait_settings) + 10.0) { return AlsGait.Walking; }                                // :987-990
    if (LocomotionState.Speed < get_max_run_speed(gait_settings) + 10.0 || max_allowed_gait != AlsGait.Sprinting) { return AlsGait.Running; }   // :992-995
    return AlsGait.Sprinting;                                                    // :997
}

view can_sprint() -> bool {                                                      // C:1000-1027
    // If the character is in view direction rotation mode, only allow sprinting if there is input and if the
    // input direction is aligned with the view direction within 50 degrees.
    if (!LocomotionState.bHasInput || Stance != AlsStance.Standing
        || ((bDesiredAiming || DesiredRotationMode == AlsRotationMode.Aiming) && !Settings.bSprintHasPriorityOverAiming)) {
        return false;                                                            // :1006-1010
    }
    if (ViewMode != AlsViewMode.FirstPerson
        && (DesiredRotationMode == AlsRotationMode.VelocityDirection || Settings.bRotateToVelocityWhenSprinting)) {
        return true;                                                             // :1012-1016
    }
    return abs(unwind_degrees(LocomotionState.InputYawAngle - ViewState.Rotation.yaw)) < 50.0;   // :1018-1026 (YawAngleThreshold)
}

pub method SetOverlayMode(NewOverlayMode: AlsOverlayMode) {                      // C:1029-1060
    if (OverlayMode == NewOverlayMode) { return; }
    OverlayMode = NewOverlayMode;                                                // :1043
    // OnOverlayModeChanged(PreviousOverlayMode);                                // :1047 (Blueprint event)
}

pub method SetLocomotionAction(NewLocomotionAction: AlsLocomotionAction) {       // C:1079-1089 (called by the SetLocomotionAction notify state)
    if (LocomotionAction != NewLocomotionAction) {
        let previous_locomotion_action = LocomotionAction;
        LocomotionAction = NewLocomotionAction;                                  // :1085
        notify_locomotion_action_changed(previous_locomotion_action);
    }
}

method notify_locomotion_action_changed(previous_locomotion_action: AlsLocomotionAction) {   // C:1091-1101
    if (!valid(LocomotionAction)) {
        host.set_input_blocked(false);                                           // :1095 CMC->SetInputBlocked(false)
    }
    apply_desired_stance();                                                      // :1098
    // OnLocomotionActionChanged(PreviousLocomotionAction);                      // :1100 (Blueprint event)
}

// ================================================================================================================================
// input, view, locomotion
// ================================================================================================================================

method refresh_input() {                                                         // C:1115-1128 (the role check :1117 is always true here)
    InputDirection = normalize(Acceleration / MaxAcceleration);                  // :1119 + SetInputDirection :1108-1112 (GetSafeNormal; x / 0 is 0)
    LocomotionState.bHasInput = length_sq(InputDirection) > KINDA_SMALL_NUMBER;  // :1122
    if (LocomotionState.bHasInput) {
        LocomotionState.InputYawAngle = direction_to_angle_xy(InputDirection);   // :1126
    }
}

method refresh_movement_base() {                                                 // C:403-428
    MovementBase = refresh_movement_base_state(MovementBase, BaseComponent, BaseLocation, BaseRotation,
                                               BaseHasRelativeLocation, BaseRelativeRotation);
}

method refresh_view(dt: float) {                                                 // C:1222-1267 (no network smoothing)
    if (MovementBase.bHasRelativeRotation) {
        // Offset the rotations to keep them in the movement base space.   :1224-1231
        ViewState.Rotation = rotator(normalize_rotator(rotatord(ViewState.Rotation) + MovementBase.DeltaRotation));
    }

    ViewState.PreviousYawAngle = ViewState.Rotation.yaw;                         // :1233

    if (MovementBase.bHasRelativeRotation) {
        // The view rotation of the controller is in world space: the replicated one is kept in the space of the base.   :1235-1243 (IsLocallyControlled)
        let relative_view = to_rotator(quat_inverse(MovementBase.Rotation) * to_quat(rotatord(ControlRotation)));
        if (!rotators_equal(ReplicatedViewRotation, rotator(relative_view))) {   // SetReplicatedViewRotation, C:1130-1143
            ReplicatedViewRotation = rotator(relative_view);                     // :1134
        }
    } else {
        let view_rotation = normalize_rotator(ControlRotation);                  // :1252 Super::GetViewRotation().GetNormalized()
        if (!rotators_equal(ReplicatedViewRotation, view_rotation)) {            // SetReplicatedViewRotation, C:1130-1143
            ReplicatedViewRotation = view_rotation;                              // :1134
        }
    }

    // RefreshViewNetworkSmoothing (:1255): off, so the final rotation is the replicated one, in world space again.   :1284-1289
    ViewState.Rotation = MovementBase.bHasRelativeRotation
        ? rotator(to_rotator(MovementBase.Rotation * to_quat(rotatord(ReplicatedViewRotation))))
        : ReplicatedViewRotation;

    // Set the yaw speed by comparing the current and previous view yaw angle, divided by delta seconds.   :1260-1266
    if (dt > SMALL_NUMBER) {
        ViewState.YawSpeed = abs(ViewState.Rotation.yaw - ViewState.PreviousYawAngle) / dt;
    }
}

method refresh_locomotion_early() {                                              // C:1335-1370
    if (!LocomotionState.bMoving && RotationMode == AlsRotationMode.VelocityDirection
        && Settings.bInheritMovementBaseRotationInVelocityDirectionRotationMode) {       // :1337-1339
        DesiredVelocityYawAngle = unwind_degrees(float(DesiredVelocityYawAngle + MovementBase.DeltaRotation.yaw));       // :1341-1342 UE_REAL_TO_FLOAT
        LocomotionState.VelocityYawAngle = unwind_degrees(float(LocomotionState.VelocityYawAngle + MovementBase.DeltaRotation.yaw));    // :1344-1345
    }

    if (MovementBase.bHasRelativeRotation) {                                     // :1348
        // Offset the rotations (actor rotation too) to keep them in the movement base space.
        LocomotionState.TargetYawAngle = unwind_degrees(float(LocomotionState.TargetYawAngle + MovementBase.DeltaRotation.yaw));                 // :1352-1353
        LocomotionState.TargetYawAngleViewSpace = unwind_degrees(float(LocomotionState.TargetYawAngleViewSpace + MovementBase.DeltaRotation.yaw));    // :1355-1356
        LocomotionState.SmoothTargetYawAngle = unwind_degrees(float(LocomotionState.SmoothTargetYawAngle + MovementBase.DeltaRotation.yaw));        // :1358-1359

        let new_rotation = rotator(normalize_rotator(rotatord(ActorRotationNow) + MovementBase.DeltaRotation));       // :1361-1365 (NewRotation.Pitch / Yaw += ..., Normalize())
        set_actor_rotation_now(new_rotation, false);                             // :1367 SetActorRotation(NewRotation)
    }

    LocomotionState.bAimingLimitAppliedThisFrame = false;                        // :1369
}

method refresh_locomotion() {                                                    // C:1372-1437
    let bHadVelocity = LocomotionState.bHasVelocity;                             // :1374

    LocomotionState.Velocity = Velocity;                                         // :1376

    // The speed equals the length of the horizontal velocity, so it does not take vertical movement into account.   :1378-1383
    LocomotionState.Speed = size_2d(LocomotionState.Velocity);                   // :1383 Size2D

    LocomotionState.bHasVelocity = LocomotionState.Speed >= 1.0;                 // :1385-1387 (HasSpeedThreshold)

    if (LocomotionState.bHasVelocity) {
        LocomotionState.VelocityYawAngle = direction_to_angle_xy(LocomotionState.Velocity);   // :1391
    }

    // (the role check :1394 is always true.)  A character that starts to move announces the yaw angle of its velocity: the RPC chain
    // ServerSetInitialVelocityYawAngle -> MulticastSetInitialVelocityYawAngle (:1425-1431, :1449-1462) also runs on the authority itself,
    // because the remote role of a replicated character is a simulated proxy even in a single player game -- the recorded takes of the
    // UE character show the effect (the rotation towards the last input direction is unblocked when the velocity starts).
    var bSendInitialVelocityYawAngle = LocomotionState.bHasVelocity && !bHadVelocity;       // :1396
    var velocity_yaw_angle_to_send = LocomotionState.VelocityYawAngle;           // :1397

    if (Settings.bRotateTowardsDesiredVelocityInVelocityDirectionRotationMode) {         // :1399
        if (PrePenetrationVelocityValid && size_2d(PrePenetrationVelocity) >= 1.0) {     // :1402-1403 TryConsumePrePenetrationAdjustmentVelocity
            bSendInitialVelocityYawAngle = !bHasDesiredVelocity;                         // :1405
            bHasDesiredVelocity = true;                                                  // :1406
            DesiredVelocityYawAngle = direction_to_angle_xy(PrePenetrationVelocity);     // :1408 SetDesiredVelocityYawAngle
        } else {
            bSendInitialVelocityYawAngle = LocomotionState.bHasVelocity && !bHasDesiredVelocity;      // :1412
            bHasDesiredVelocity = LocomotionState.bHasVelocity;                          // :1413
            DesiredVelocityYawAngle = LocomotionState.VelocityYawAngle;                  // :1415
        }

        velocity_yaw_angle_to_send = DesiredVelocityYawAngle;                            // :1418
    }

    if (bSendInitialVelocityYawAngle) {                                          // :1425
        DesiredVelocityYawAngle = velocity_yaw_angle_to_send;                    // :1458
        LocomotionState.VelocityYawAngle = velocity_yaw_angle_to_send;           // :1459
        LocomotionState.bRotationTowardsLastInputDirectionBlocked = false;       // :1460
    }

    // Character is moving if has speed and current acceleration, or if the speed is greater than the moving speed threshold.   :1433
    LocomotionState.bMoving = (LocomotionState.bHasInput && LocomotionState.bHasVelocity)
                           || LocomotionState.Speed > Settings.MovingSpeedThreshold;     // :1435-1436
}

method refresh_locomotion_late() {                                               // C:1439-1447
    if (!valid(LocomotionMode) || valid(LocomotionAction)) {
        refresh_target_yaw_angle_using_actor_rotation();                         // :1441-1444
    }
    LocomotionState.bResetAimingLimit = !LocomotionState.bAimingLimitAppliedThisFrame;   // :1446
}

pub method Jump() {                                                              // C:1464-1471
    if (Stance == AlsStance.Standing && !valid(LocomotionAction) && LocomotionMode == AlsLocomotionMode.Grounded) {
        host.jump();                                                             // :1469 Super::Jump() (the movement component starts the jump and calls OnJumped: `on jumped`)
    }
}

// ================================================================================================================================
// rotation
// ================================================================================================================================

method refresh_rotation(dt: float) {                                             // C:1664-1668
    refresh_grounded_rotation(dt);                                               // :1666
    refresh_in_air_rotation(dt);                                                 // :1667
}

method refresh_grounded_rotation(dt: float) {                                    // C:1514-1662
    if (valid(LocomotionAction) || LocomotionMode != AlsLocomotionMode.Grounded) { return; }     // :1516-1519

    if (HasAnyRootMotion) {                                                      // :1521
        refresh_target_yaw_angle_using_actor_rotation();                         // :1523
        return;
    }

    if (!LocomotionState.bMoving) {                                              // Not moving.  :1527
        apply_rotation_yaw_speed_animation_curve(dt);                            // :1531
        // if (RefreshCustomGroundedNotMovingRotation(dt)) { return; }           // :1533 (extension point)

        if (RotationMode == AlsRotationMode.Aiming || ViewMode == AlsViewMode.FirstPerson) {     // :1538
            refresh_grounded_aiming_rotation(dt);                                // :1540
            return;
        }

        if (RotationMode == AlsRotationMode.VelocityDirection) {                 // :1544
            var target_yaw_angle = 0.0;
            if (LocomotionState.bRotationTowardsLastInputDirectionBlocked) {     // :1548
                // Rotate to the last target yaw angle, relative to the movement base or not.   :1551
                target_yaw_angle = LocomotionState.TargetYawAngle;               // :1552

                if (MovementBase.bHasRelativeLocation && !MovementBase.bHasRelativeRotation
                    && Settings.bInheritMovementBaseRotationInVelocityDirectionRotationMode) {       // :1554-1555
                    target_yaw_angle = float(target_yaw_angle + MovementBase.DeltaRotation.yaw);     // :1557
                }
            } else {
                // Rotate to the last velocity direction.
                target_yaw_angle = Settings.bRotateTowardsDesiredVelocityInVelocityDirectionRotationMode
                    ? DesiredVelocityYawAngle : LocomotionState.VelocityYawAngle;       // :1565-1567
            }
            // RotationInterpolationHalfLife 0.1, TargetYawAngleRotationSpeed 800     :1570-1571
            set_rotation_extra_smooth(target_yaw_angle, dt, 0.1, 800.0);         // :1573
            return;
        }

        if (RotationMode == AlsRotationMode.ViewDirection) {                     // :1577
            if ((!LocomotionState.bHasInput && LocomotionState.bRotationTowardsLastInputDirectionBlocked)
                || !Settings.bAutoRotateOnAnyInputWhileNotMovingInViewDirectionRotationMode) {     // :1579-1580
                refresh_target_yaw_angle_using_actor_rotation();                 // :1582
                return;
            }

            // Rotate to the last view direction.
            let target_yaw_angle = LocomotionState.bHasInput ? ViewState.Rotation.yaw : LocomotionState.TargetYawAngle;   // :1588-1590
            set_rotation_extra_smooth(target_yaw_angle, dt, calculate_grounded_moving_rotation_interpolation_half_life(), 500.0);        // :1592-1596
            return;
        }

        refresh_target_yaw_angle_using_actor_rotation();                         // :1600
        return;
    }

    // Moving.  :1604
    // if (RefreshCustomGroundedMovingRotation(dt)) { return; }                  // :1606 (extension point)

    if (RotationMode == AlsRotationMode.Aiming || ViewMode == AlsViewMode.FirstPerson) {         // :1611
        refresh_grounded_aiming_rotation(dt);                                    // :1613
        return;
    }

    if (RotationMode == AlsRotationMode.VelocityDirection
        && (LocomotionState.bHasInput || !LocomotionState.bRotationTowardsLastInputDirectionBlocked)) {   // :1617-1618
        LocomotionState.bRotationTowardsLastInputDirectionBlocked = false;       // :1620

        let target_yaw_angle = Settings.bRotateTowardsDesiredVelocityInVelocityDirectionRotationMode
            ? DesiredVelocityYawAngle : LocomotionState.VelocityYawAngle;        // :1622-1626
        set_rotation_extra_smooth(target_yaw_angle, dt, calculate_grounded_moving_rotation_interpolation_half_life(), 800.0);          // :1628-1632
        return;
    }

    if (RotationMode == AlsRotationMode.ViewDirection
        && (LocomotionState.bHasInput || !LocomotionState.bRotationTowardsLastInputDirectionBlocked)) {         // :1636-1637
        LocomotionState.bRotationTowardsLastInputDirectionBlocked = false;       // :1639

        var target_yaw_angle = 0.0;
        if (Gait == AlsGait.Sprinting) {                                         // :1643
            target_yaw_angle = LocomotionState.VelocityYawAngle;                 // :1645
        } else {
            target_yaw_angle = ViewState.Rotation.yaw + RotationYawOffsetCurve;  // :1649-1650 (view yaw + the curve of the animation)
        }

        set_rotation_extra_smooth(target_yaw_angle, dt, calculate_grounded_moving_rotation_interpolation_half_life(), 500.0);          // :1653-1657
        return;
    }

    refresh_target_yaw_angle_using_actor_rotation();                             // :1661
}

view calculate_grounded_moving_rotation_interpolation_half_life() -> float {     // C:1789-1810
    // The rotation speed from the rotation speed curve of the movement gait settings, indexed by the gait amount.
    let gait_settings = MovementSettings.RotationModes[RotationMode].Stances[Stance];        // :1795 GetGaitSettings()
    var interpolation_half_life = 0.2;                                           // :1797 DefaultInterpolationHalfLife
    if (valid(gait_settings.RotationInterpolationSpeedCurve)) {                  // :1800 ALS_ENSURE(IsValid(curve))
        interpolation_half_life = gait_settings.RotationInterpolationSpeedCurve.eval(max(1.0, GaitAmount));    // :1801
    }
    // MinInterpolationHalfLifeMultiplier 0.333333, ReferenceViewYawSpeed 300     :1805-1806
    return interpolation_half_life * lerp_clamped(1.0, 0.333333, ViewState.YawSpeed / 300.0);   // :1808-1809
}

method refresh_grounded_aiming_rotation(dt: float) {                             // C:1680-1716
    NewActorRotation = ActorRotationNow;                                         // :1682

    if (!LocomotionState.bHasInput && !LocomotionState.bMoving) {                // Not moving.  :1684
        set_target_yaw_angle(ViewState.Rotation.yaw);                            // :1688

        if (!constrain_aiming_rotation(dt, true)) { return; }                    // :1690
    } else {                                                                     // Moving.  :1695
        // RotationInterpolationHalfLife 0.1, TargetYawAngleRotationSpeed 1000     :1699-1700
        set_target_yaw_angle_smooth(ViewState.Rotation.yaw, dt, 1000.0);         // :1702

        NewActorRotation.yaw = damper_exact_angle(unwind_degrees(NewActorRotation.yaw), LocomotionState.SmoothTargetYawAngle, dt, 0.1);   // :1704-1706

        if (constrain_aiming_rotation(dt, false)) {                              // :1708
            // Cancel the extra smooth rotation, otherwise the actor will rotate too weirdly.      :1710
            LocomotionState.SmoothTargetYawAngle = LocomotionState.TargetYawAngle;     // :1711
        }
    }

    set_actor_rotation_now(NewActorRotation, false);                             // :1715
}

// Limits the actor's yaw relative to the view when aiming; edits NewActorRotation (the `FRotator& ActorRotation` of the C++).
method constrain_aiming_rotation(dt: float, bApplySecondaryConstraint: bool) -> bool {      // C:1718-1787
    LocomotionState.bAimingLimitAppliedThisFrame = true;                         // :1723

    if (LocomotionState.bResetAimingLimit) {
        LocomotionState.AimingYawAngleLimit = 180.0;                             // :1725-1728
    }

    var actor_yaw_angle_view_space = unwind_degrees(ViewState.Rotation.yaw - NewActorRotation.yaw);   // :1730

    let min_aiming_yaw_angle_limit = Settings.AimingYawAngleLimit;               // :1732

    if (abs(actor_yaw_angle_view_space) <= min_aiming_yaw_angle_limit + KINDA_SMALL_NUMBER) {     // :1734
        LocomotionState.AimingYawAngleLimit = min_aiming_yaw_angle_limit;        // :1736
        return false;                                                            // :1737
    }

    actor_yaw_angle_view_space = remap_angle_for_counter_clockwise_rotation(actor_yaw_angle_view_space);   // :1740

    // Secondary constraint: increases the character's rotation speed; typically only when the character is not moving.   :1742-1745
    if (bApplySecondaryConstraint) {
        // Interpolate the angle only up to the point at which the constraints no longer apply, for a smoother completion.   :1749-1750
        let target_actor_yaw_angle_view_space = clamp(actor_yaw_angle_view_space, -min_aiming_yaw_angle_limit, min_aiming_yaw_angle_limit);   // :1752
        let delta_yaw_angle = unwind_degrees(target_actor_yaw_angle_view_space - actor_yaw_angle_view_space);      // :1753

        if (is_nearly_zero(delta_yaw_angle, KINDA_SMALL_NUMBER)) {                   // :1755
            actor_yaw_angle_view_space = target_actor_yaw_angle_view_space;      // :1757
        } else {
            // RotationInterpolationHalfLife 0.1 (:1747)
            let interpolation_amount = damper_exact_alpha(dt, 0.1);              // :1761
            actor_yaw_angle_view_space = unwind_degrees(actor_yaw_angle_view_space + delta_yaw_angle * interpolation_amount);   // :1762
        }
    }

    // Primary constraint: the character may not rotate beyond a certain angle in the view space.   :1766
    if (abs(actor_yaw_angle_view_space) > LocomotionState.AimingYawAngleLimit + KINDA_SMALL_NUMBER) {   // :1768
        actor_yaw_angle_view_space = clamp(actor_yaw_angle_view_space, -LocomotionState.AimingYawAngleLimit, LocomotionState.AimingYawAngleLimit);   // :1770-1772
    } else {
        LocomotionState.AimingYawAngleLimit = max(abs(actor_yaw_angle_view_space), min_aiming_yaw_angle_limit);   // :1776
    }

    let previous_actor_yaw_angle = NewActorRotation.yaw;                         // :1779

    NewActorRotation.yaw = unwind_degrees(ViewState.Rotation.yaw - actor_yaw_angle_view_space);   // :1781

    // KINDA_SMALL_NUMBER: converting back to a world space rotation may introduce rounding error.   :1783-1784
    return !is_nearly_zero(unwind_degrees(NewActorRotation.yaw - previous_actor_yaw_angle), KINDA_SMALL_NUMBER);   // :1786
}

method apply_rotation_yaw_speed_animation_curve(dt: float) {                     // C:1812-1824
    let delta_yaw_angle = RotationYawSpeedCurve * dt;                            // :1814
    if (abs(delta_yaw_angle) > SMALL_NUMBER) {                                   // :1815
        var new_rotation = ActorRotationNow;                                     // :1817
        new_rotation.yaw += delta_yaw_angle;                                     // :1818
        set_actor_rotation_now(new_rotation, false);                             // :1820
        refresh_target_yaw_angle_using_actor_rotation();                         // :1822
    }
}

method refresh_in_air_rotation(dt: float) {                                      // C:1826-1871
    if (valid(LocomotionAction) || LocomotionMode != AlsLocomotionMode.InAir) { return; }       // :1828-1831

    // if (RefreshCustomInAirRotation(dt)) { return; }                           // :1833 (extension point)

    if (RotationMode == AlsRotationMode.Aiming || ViewMode == AlsViewMode.FirstPerson) {         // :1838
        refresh_in_air_aiming_rotation(dt);                                      // :1840
        return;
    }

    if (RotationMode == AlsRotationMode.VelocityDirection || RotationMode == AlsRotationMode.ViewDirection) {   // :1844
        // RotationInterpolationHalfLife 0.2 (:1846)
        if (Settings.InAirRotationMode == AlsInAirRotationMode.KeepViewSpaceRotation) {          // :1850
            set_rotation_smooth(ViewState.Rotation.yaw - LocomotionState.TargetYawAngleViewSpace, dt, 0.2);   // :1851-1852
        } else if (Settings.InAirRotationMode == AlsInAirRotationMode.RotateToVelocity && LocomotionState.bMoving) {   // :1855-1856
            set_rotation_smooth(LocomotionState.VelocityYawAngle, dt, 0.2);      // :1858 (not moving: the default branch, like the C++ fall through)
        } else {
            refresh_target_yaw_angle_using_actor_rotation();                     // :1863
        }
        return;
    }

    refresh_target_yaw_angle_using_actor_rotation();                             // :1870
}

method refresh_in_air_aiming_rotation(dt: float) {                               // C:1878-1891
    // RotationInterpolationHalfLife 0.1 (:1880)
    set_target_yaw_angle(ViewState.Rotation.yaw);                                // :1882

    var new_rotation = ActorRotationNow;                                         // :1884
    new_rotation.yaw = damper_exact_angle(unwind_degrees(new_rotation.yaw), LocomotionState.SmoothTargetYawAngle, dt, 0.1);   // :1885-1886

    NewActorRotation = new_rotation;
    constrain_aiming_rotation(dt, false);                                        // :1888 (the result is not used)
    set_actor_rotation_now(NewActorRotation, false);                             // :1890
}

method set_rotation_smooth(target_yaw_angle: float, dt: float, interpolation_half_life: float) {      // C:1893-1902
    set_target_yaw_angle(target_yaw_angle);                                      // :1895

    var new_rotation = ActorRotationNow;                                         // :1897
    new_rotation.yaw = damper_exact_angle(unwind_degrees(new_rotation.yaw), LocomotionState.SmoothTargetYawAngle, dt, interpolation_half_life);   // :1898-1899

    set_actor_rotation_now(new_rotation, false);                                 // :1901
}

method set_rotation_extra_smooth(target_yaw_angle: float, dt: float, interpolation_half_life: float, target_yaw_angle_rotation_speed: float) {   // C:1904-1914
    set_target_yaw_angle_smooth(target_yaw_angle, dt, target_yaw_angle_rotation_speed);   // :1907

    var new_rotation = ActorRotationNow;                                         // :1909
    new_rotation.yaw = damper_exact_angle(unwind_degrees(new_rotation.yaw), LocomotionState.SmoothTargetYawAngle, dt, interpolation_half_life);   // :1910-1911

    set_actor_rotation_now(new_rotation, false);                                 // :1913
}

method set_rotation_instant(target_yaw_angle: float, teleport: bool) {           // C:1916-1924
    set_target_yaw_angle(target_yaw_angle);                                      // :1918

    var new_rotation = ActorRotationNow;                                         // :1920
    new_rotation.yaw = target_yaw_angle;                                         // :1921

    set_actor_rotation_now(new_rotation, teleport);                              // :1923
}

method refresh_target_yaw_angle_using_actor_rotation() {                         // C:1926-1931
    set_target_yaw_angle(ActorRotationNow.yaw);                                  // :1928-1930
}

method set_target_yaw_angle(target_yaw_angle: float) {                           // C:1933-1940
    LocomotionState.TargetYawAngle = unwind_degrees(target_yaw_angle);           // :1935
    LocomotionState.SmoothTargetYawAngle = LocomotionState.TargetYawAngle;       // :1937
    refresh_target_yaw_angle_view_space();                                       // :1939
}

method set_target_yaw_angle_smooth(target_yaw_angle: float, dt: float, rotation_speed: float) {      // C:1942-1950
    LocomotionState.TargetYawAngle = unwind_degrees(target_yaw_angle);           // :1944
    LocomotionState.SmoothTargetYawAngle = interpolate_angle_constant(LocomotionState.SmoothTargetYawAngle, LocomotionState.TargetYawAngle, dt, rotation_speed);   // :1946-1947
    refresh_target_yaw_angle_view_space();                                       // :1949
}

method refresh_target_yaw_angle_view_space() {                                   // C:1952-1956
    LocomotionState.TargetYawAngleViewSpace = unwind_degrees(ViewState.Rotation.yaw - LocomotionState.TargetYawAngle);   // :1954-1955
}

// ================================================================================================================================
// the movement component: gait settings and grounded movement settings (AlsCharacterMovementComponent.cpp)
// ================================================================================================================================

// RefreshGroundedMovementSettings, CMC:936-1020, called by PhysWalking (CMC:335) while the character is walking on the ground.
method push_movement_settings() {
    if (!IsGrounded) { return; }
    push_grounded_movement_settings();
}

// The body of RefreshGroundedMovementSettings, CMC:936-1020.
method push_grounded_movement_settings() {
    let gait_settings = MovementSettings.RotationModes[RotationMode].Stances[Stance];            // CMC:910-913 GaitSettings
    var walk_speed = gait_settings.WalkForwardSpeed;                             // :938
    var run_speed = gait_settings.RunForwardSpeed;                               // :939

    if (gait_settings.bAllowDirectionDependentMovementSpeed && length_sq(Velocity) > KINDA_SMALL_NUMBER) {   // :941-943
        // Ideally actor rotation, but ALS controls it itself and does not replicate it: the view rotation of the controller.   :945-954
        let view_rotation_gravity_space = get_twist(to_quat(ControlRotation), vec3(0.0, 0.0, 1.0));    // :956 UAlsRotation::GetTwist about the up axis
        let velocity_view_space = unrotate(view_rotation_gravity_space, Velocity).xy;                  // :958
        let velocity_yaw_angle_view_space = direction_to_angle(velocity_view_space);                   // :959

        let forward_speed_amount = 1.0 - clamp01(range_pct(MovementSettings.VelocityAngleToSpeedInterpolationRange.Min,
                                                           MovementSettings.VelocityAngleToSpeedInterpolationRange.Max,
                                                           abs(velocity_yaw_angle_view_space)));      // :961-964

        walk_speed = lerp(gait_settings.WalkBackwardSpeed, gait_settings.WalkForwardSpeed, forward_speed_amount);    // :966
        run_speed = lerp(gait_settings.RunBackwardSpeed, gait_settings.RunForwardSpeed, forward_speed_amount);       // :967
    }

    // Map the character's current speed to the speed ranges from the movement settings, so that the mapped range
    // can be used in calculations for consistent results.     :970-971
    let speed = size_2d(Velocity);                                               // :973

    if (speed > run_speed) {                                                     // :975
        GaitAmount = map_range_clamped(run_speed, gait_settings.SprintSpeed, 2.0, 3.0, speed);       // :977
    } else if (speed > walk_speed) {                                             // :979
        GaitAmount = map_range_clamped(walk_speed, run_speed, 1.0, 2.0, speed);  // :981
    } else {
        GaitAmount = map_range_clamped(0.0, walk_speed, 0.0, 1.0, speed);        // :985
    }

    var max_walk_speed = gait_settings.RunForwardSpeed;                          // :1002
    if (MaxAllowedGait == AlsGait.Walking) {                                     // :988
        max_walk_speed = walk_speed;                                             // :990
    } else if (MaxAllowedGait == AlsGait.Running) {                              // :992
        max_walk_speed = run_speed;                                              // :994
    } else if (MaxAllowedGait == AlsGait.Sprinting) {                            // :996
        max_walk_speed = gait_settings.SprintSpeed;                              // :998
    }
    host.set_max_walk_speed(max_walk_speed);                                     // :990-1002
    host.set_max_walk_speed_crouched(max_walk_speed);                            // :1005

    // Acceleration, deceleration and ground friction from a curve of the gait amount.   :1007-1018
    if (valid(gait_settings.AccelerationAndDecelerationAndGroundFrictionCurve)) {            // :1010 ALS_ENSURE(IsValid(curve))
        let acceleration_and_deceleration_and_ground_friction = gait_settings.AccelerationAndDecelerationAndGroundFrictionCurve.eval(GaitAmount);   // FloatCurves[0..2].Eval(GaitAmount)
        host.set_max_acceleration_walking(acceleration_and_deceleration_and_ground_friction.x);          // :1016
        host.set_braking_deceleration_walking(acceleration_and_deceleration_and_ground_friction.y);      // :1017
        host.set_ground_friction(acceleration_and_deceleration_and_ground_friction.z);                   // :1018
    }
}

// ================================================================================================================================
// rolling (AlsCharacter_Actions.cpp:22-139)
// ================================================================================================================================

method select_roll_montage() -> montage {                                        // CA:22-25 SelectRollMontage_Implementation (a Blueprint event; the default returns the montage of the settings)
    return Settings.Rolling.Montage;                                             // :24
}

method is_rolling_allowed_to_start(montage_to_play: montage) -> bool {           // CA:27-32
    return !valid(LocomotionAction)
        || (LocomotionAction == AlsLocomotionAction.Rolling && !host.montage_is_playing(montage_to_play));       // :29-31
}

pub method StartRollingGrounded(PlayRate: float) {                               // CA:34-43
    if (LocomotionMode == AlsLocomotionMode.Grounded) {                          // :36
        StartRolling(Settings.Rolling.bRotateToInputOnStart && LocomotionState.bHasInput
                     ? LocomotionState.InputYawAngle : unwind_degrees(ActorRotationNow.yaw), PlayRate);         // :38-41
    }
}

pub method StartRolling(TargetYawAngle: float, PlayRate: float) {               // CA:45-72 (the role check :47-50 and the RPCs :61-71 are dropped)
    let montage_to_play = select_roll_montage();                                 // :52
    if (!valid(montage_to_play)) { return; }                                     // :54 ALS_ENSURE(IsValid(Montage))
    let allowed = is_rolling_allowed_to_start(montage_to_play);                  // :54
    if (!allowed) { return; }
    start_rolling_implementation(montage_to_play, PlayRate, unwind_degrees(ActorRotationNow.yaw), TargetYawAngle);        // :59, :69
}

method start_rolling_implementation(montage_to_play: montage, play_rate: float, initial_yaw_angle: float, target_yaw_angle: float) {      // CA:90-101
    let allowed = is_rolling_allowed_to_start(montage_to_play);                  // :93
    if (!allowed) { return; }
    host.montage_play(montage_to_play, play_rate);                               // :93 Montage_Play(Montage, PlayRate) > 0 (a valid montage plays)
    RollingState.TargetYawAngle = target_yaw_angle;                              // :95
    set_rotation_instant(initial_yaw_angle, false);                              // :97
    SetLocomotionAction(AlsLocomotionAction.Rolling);                            // :99 (the SetLocomotionAction notify state of the montage ends it)
}

method refresh_rolling(dt: float) {                                              // CA:103-113 (the role check :105 is always false here)
    if (RootMotionModeOfAnimation == RootMotionMode.NoRootMotionExtraction || RootMotionModeOfAnimation == RootMotionMode.IgnoreRootMotion) {      // :106
        // Refresh rolling physics here because the physics rotation hook is not called with ignored root motion.
        refresh_rolling_physics(dt);                                             // :111
    }
}

method refresh_rolling_physics(dt: float) {                                      // CA:116-139
    if (LocomotionAction != AlsLocomotionAction.Rolling) { return; }             // :118-121

    var target_rotation = ActorRotationNow;                                      // :123 UpdatedComponent->GetComponentRotation()
    if (Settings.Rolling.RotationInterpolationHalfLife <= 0.0) {                 // :125
        target_rotation.yaw = RollingState.TargetYawAngle;                       // :127
        set_actor_rotation_now(target_rotation, true);                           // :129 MoveUpdatedComponent(Zero, TargetRotation, false, nullptr, ETeleportType::TeleportPhysics)
    } else {
        target_rotation.yaw = damper_exact_angle(unwind_degrees(target_rotation.yaw), RollingState.TargetYawAngle, dt,
                                                 Settings.Rolling.RotationInterpolationHalfLife);               // :133-135
        set_actor_rotation_now(target_rotation, false);                          // :137 MoveUpdatedComponent(Zero, TargetRotation, false)
    }
}

// ================================================================================================================================
// mantling (AlsCharacter_Actions.cpp:141-713, RootMotionSources/AlsRootMotionSource_Mantling.cpp:37-128)
// ================================================================================================================================

pub method StartMantling() -> bool {                                             // CA:141-154
    if (LocomotionMode == AlsLocomotionMode.Grounded) {                          // :143
        return start_mantling_with(Settings.Mantling.GroundedTrace);             // :145
    }
    if (LocomotionMode == AlsLocomotionMode.InAir) {                             // :148
        return start_mantling_with(Settings.Mantling.InAirTrace);                // :150
    }
    return false;                                                                // :153
}

method auto_start_mantling() -> bool {                                           // CA:156-160 AutoStartMantling (IsLocallyControlled() is always true)
    if (!Settings.Mantling.bAutoStartMantlingInAir || LocomotionMode != AlsLocomotionMode.InAir) { return false; }        // :158-159
    return start_mantling_with(Settings.Mantling.InAirTrace);                    // :159
}

view is_mantling_allowed_to_start() -> bool {                                    // CA:162-165 IsMantlingAllowedToStart_Implementation
    return !valid(LocomotionAction);                                             // :164
}

// StartMantling(const FAlsMantlingTraceSettings& TraceSettings): finds a ledge the character cannot walk on but can step up to, a walkable
// place on top of it, and enough room for the capsule at both ends.  Traces go to the host's world queries; nothing is cached.
method start_mantling_with(trace: AlsMantlingTraceSettings) -> bool {            // CA:167-448
    let allowed = is_mantling_allowed_to_start();
    if (!Settings.Mantling.bAllowMantling || !allowed) { return false; }         // :169 (the role check is dropped)

    let actor_yaw_angle = unwind_degrees(ActorRotationNow.yaw);                  // :175 (the actor location is read from the host: ActorLocation, :174)

    var forward_trace_angle = actor_yaw_angle;                                   // :177-189
    if (LocomotionState.bHasVelocity) {
        forward_trace_angle = LocomotionState.bHasInput
            ? LocomotionState.VelocityYawAngle + clamp_angle(LocomotionState.InputYawAngle - LocomotionState.VelocityYawAngle,
                                                             -Settings.Mantling.MaxReachAngle, Settings.Mantling.MaxReachAngle)
            : LocomotionState.VelocityYawAngle;                                  // :180-184
    } else if (LocomotionState.bHasInput) {
        forward_trace_angle = LocomotionState.InputYawAngle;                     // :188
    }

    let forward_trace_delta_angle = unwind_degrees(forward_trace_angle - actor_yaw_angle);       // :191
    if (abs(forward_trace_delta_angle) > Settings.Mantling.TraceAngleThreshold) { return false; }    // :192-195

    let forward_trace_direction = vec3d(angle_to_direction_xy(
        actor_yaw_angle + clamp_angle(forward_trace_delta_angle, -Settings.Mantling.MaxReachAngle, Settings.Mantling.MaxReachAngle)));      // :197-200 (an FVector)

    let capsule_bottom_location = vec3d(ActorLocation.x, ActorLocation.y, ActorLocation.z - CapsuleHalfHeight);   // :212 (FVector: the locations of the mantle are doubles up to the root motion)
    let trace_capsule_radius = CapsuleRadius - 1.0;                              // :214
    let ledge_height_min = min(trace.LedgeHeight.x, trace.LedgeHeight.y);        // FVector2D::GetMin()
    let ledge_height_delta = float((max(trace.LedgeHeight.x, trace.LedgeHeight.y) - ledge_height_min) * CapsuleScale);      // :216 UE_REAL_TO_FLOAT(.. * CapsuleScale)

    // Trace forward to find an object the character cannot walk on.            :218
    var forward_trace_start = capsule_bottom_location - forward_trace_direction * CapsuleRadius;       // :222
    forward_trace_start.z += (trace.LedgeHeight.x + trace.LedgeHeight.y) * 0.5 * CapsuleScale - MAX_FLOOR_DIST;      // :223-224
    let forward_trace_end = forward_trace_start
        + forward_trace_direction * (CapsuleRadius + (trace.ReachDistance + 1.0) * CapsuleScale);      // :226
    let forward_trace_capsule_half_height = ledge_height_delta * 0.5;            // :228
    let forward_trace_hit = host.sweep_capsule(forward_trace_start, forward_trace_end, trace_capsule_radius, forward_trace_capsule_half_height,
                                               Settings.Mantling.MantlingTraceChannel, Settings.Mantling.MantlingTraceResponses);    // :231-234

    let target_primitive = forward_trace_hit.primitive;                          // :236
    if (!forward_trace_hit.blocking || forward_trace_hit.start_penetrating       // :238 IsValidBlockingHit()
        || !host.primitive_valid(target_primitive)                               // :239
        || host.primitive_speed(target_primitive) > Settings.Mantling.TargetPrimitiveSpeedThreshold    // :240
        || !host.primitive_can_step_up(target_primitive)                         // :241
        || host.is_walkable(forward_trace_hit)) {                                // :242
        return false;                                                            // :253
    }

    let target_direction = vec3d(0.0, 0.0, 0.0) - safe_normal_2d(forward_trace_hit.normal);      // :256 -ImpactNormal.GetSafeNormal2D()

    // Trace downward from the first trace's impact point and determine if the hit location is walkable.      :258
    let target_location_offset = target_direction * (trace.TargetLocationOffset * CapsuleScale);       // :262
    let downward_trace_start = vec3d(forward_trace_hit.point_d.x + target_location_offset.x,
                                     forward_trace_hit.point_d.y + target_location_offset.y,
                                     capsule_bottom_location.z + ledge_height_delta + 2.5 * trace_capsule_radius + MIN_FLOOR_DIST);    // :264-268
    let downward_trace_end = vec3d(downward_trace_start.x, downward_trace_start.y,
                                   capsule_bottom_location.z + ledge_height_min * CapsuleScale + trace_capsule_radius - MAX_FLOOR_DIST);  // :270-275
    let downward_trace_hit = host.sweep_sphere(downward_trace_start, downward_trace_end, trace_capsule_radius,
                                               Settings.Mantling.MantlingTraceChannel, Settings.Mantling.MantlingTraceResponses);    // :278-280

    let slope_angle_cos = downward_trace_hit.normal.z;                           // :282
    // The approximate slope angle is used in situations where the normal slope angle cannot convey the true nature of the surface slope,
    // for example, for a 45 degree staircase the slope angle will always be 90 degrees, while the approximate slope angle will be ~45 degrees.
    let approximate_slope_normal = normalize(downward_trace_hit.location_d - downward_trace_hit.point_d);      // :288-289
    let approximate_slope_angle_cos = float(approximate_slope_normal.z);         // :291 UE_REAL_TO_FLOAT
    if (slope_angle_cos < Settings.Mantling.SlopeAngleThresholdCos
        || approximate_slope_angle_cos < Settings.Mantling.SlopeAngleThresholdCos
        || !host.is_walkable(downward_trace_hit)) {                              // :293-295
        return false;                                                            // :310
    }

    // Check that there is enough free space for the capsule at the target location.   :313
    let target_location = vec3d(downward_trace_hit.location_d.x, downward_trace_hit.location_d.y,
                                downward_trace_hit.point_d.z + MIN_FLOOR_DIST);  // :317-321 (double: 130 + 1.9f + 90 is 221.89999997615814, not the float 221.89999)
    let target_capsule_location = vec3d(target_location.x, target_location.y, target_location.z + CapsuleHalfHeight);      // :323
    if (host.overlap_capsule(target_capsule_location, CapsuleRadius, CapsuleHalfHeight,
                             Settings.Mantling.MantlingTraceChannel, Settings.Mantling.MantlingTraceResponses)) {          // :325-327
        return false;                                                            // :345
    }

    // Perform additional overlap at the approximate start location to ensure there are no vertical obstacles on the path, such as a ceiling.   :348
    let start_location_offset = target_direction * (trace.StartLocationOffset * CapsuleScale);       // :353
    let start_location = vec3d(forward_trace_hit.point_d.x - start_location_offset.x, forward_trace_hit.point_d.y - start_location_offset.y,
                               (downward_trace_hit.location_d.z + downward_trace_end.z) * 0.5);      // :355-359
    let start_location_trace_capsule_half_height = float(downward_trace_hit.location_d.z - downward_trace_end.z) * 0.5 + trace_capsule_radius;    // :361-363
    if (host.overlap_capsule(start_location, trace_capsule_radius, start_location_trace_capsule_half_height,
                             Settings.Mantling.MantlingTraceChannel, Settings.Mantling.MantlingTraceResponses)) {          // :365-367
        return false;                                                            // :386
    }

    var parameters = AlsMantlingParameters();                                    // :404
    parameters.TargetPrimitive = target_primitive;                               // :406
    parameters.MantlingHeight = float((target_location.z - capsule_bottom_location.z) / CapsuleScale);   // :407 UE_REAL_TO_FLOAT

    // Determine the mantling type by checking the movement mode and mantling height.   :409
    parameters.MantlingType = LocomotionMode != AlsLocomotionMode.Grounded ? AlsMantlingType.InAir
        : parameters.MantlingHeight > Settings.Mantling.MantlingHighHeightThreshold ? AlsMantlingType.High : AlsMantlingType.Low;      // :411-415

    // If the target primitive cannot move, use world space to improve performance by skipping coordinate space transformations.   :417
    let target_rotation = to_orientation_quat(target_direction);                 // :402
    if (host.primitive_uses_relative_location(target_primitive)) {               // :420 MovementBaseUtility::UseRelativeLocation(&MovementBaseData)
        let relative_target = relative_transform(transformd(target_capsule_location, target_rotation),
                                                 host.primitive_transform(target_primitive));            // :422-424 GetRelativeTransform(TargetPrimitive->GetComponentTransform())
        parameters.TargetLocation = relative_target.location;                    // :426
        parameters.TargetRotation = to_rotator(relative_target.rotation);        // :427 TargetTransform.Rotator()
    } else {
        parameters.TargetLocation = target_capsule_location;                     // :431
        parameters.TargetRotation = to_rotator(target_rotation);                 // :432 (FQuat -> FRotator, double)
    }

    start_mantling_implementation(parameters);                                   // :443 (the role branches and the RPCs :435-445 are dropped)
    return true;                                                                 // :447
}

// SelectMantlingSettings: a Blueprint event in ALS (CA:577-580 returns nullptr), overridden in B_Als_Character.  The sample's choice among
// the low mantles by overlay mode is not exported with the pack (only the Box case is certain), so Low is MS_Als_Low unless the overlay is
// the box: a project that wants more kinds adds a kind, a param and a branch in the views below.
view select_mantling_settings(mantling_type: AlsMantlingType) -> AlsMantlingSettingsKind {     // CA:577-580
    if (mantling_type == AlsMantlingType.High) { return AlsMantlingSettingsKind.High; }
    if (mantling_type == AlsMantlingType.InAir) { return AlsMantlingSettingsKind.HighInAir; }
    return OverlayMode == AlsOverlayMode.Box ? AlsMantlingSettingsKind.LowBox : AlsMantlingSettingsKind.Low;
}

// The members of the selected data asset (AlsMantlingSettings.h:42-77).  The asset itself cannot be handed around in DAL, so each view
// reads it out of the param of its kind.
view mantling_settings_values(kind: AlsMantlingSettingsKind) -> AlsMantlingSettingsValues {      // CA:578-597 (the reads of MantlingSettings->...)
    if (kind == AlsMantlingSettingsKind.High) {
        return AlsMantlingSettingsValues(Montage: MantlingHigh.Montage, bAutoCalculateStartTime: MantlingHigh.bAutoCalculateStartTime,
            StartTimeReferenceHeight: MantlingHigh.StartTimeReferenceHeight, StartTime: MantlingHigh.StartTime,
            MotionWarpingTimeRange: MantlingHigh.MotionWarpingTimeRange);
    }
    if (kind == AlsMantlingSettingsKind.HighInAir) {
        return AlsMantlingSettingsValues(Montage: MantlingHighInAir.Montage, bAutoCalculateStartTime: MantlingHighInAir.bAutoCalculateStartTime,
            StartTimeReferenceHeight: MantlingHighInAir.StartTimeReferenceHeight, StartTime: MantlingHighInAir.StartTime,
            MotionWarpingTimeRange: MantlingHighInAir.MotionWarpingTimeRange);
    }
    if (kind == AlsMantlingSettingsKind.LowBox) {
        return AlsMantlingSettingsValues(Montage: MantlingLowBox.Montage, bAutoCalculateStartTime: MantlingLowBox.bAutoCalculateStartTime,
            StartTimeReferenceHeight: MantlingLowBox.StartTimeReferenceHeight, StartTime: MantlingLowBox.StartTime,
            MotionWarpingTimeRange: MantlingLowBox.MotionWarpingTimeRange);
    }
    return AlsMantlingSettingsValues(Montage: MantlingLow.Montage, bAutoCalculateStartTime: MantlingLow.bAutoCalculateStartTime,
        StartTimeReferenceHeight: MantlingLow.StartTimeReferenceHeight, StartTime: MantlingLow.StartTime,
        MotionWarpingTimeRange: MantlingLow.MotionWarpingTimeRange);
}

// FAlphaBlend::AlphaToBlendOption(WarpAmount, MantlingSettings->MotionWarpingLocationBlendOption, ...CustomBlendCurve)
view mantling_location_warp(kind: AlsMantlingSettingsKind, warp_amount: float) -> float {       // RMS:68-72
    if (kind == AlsMantlingSettingsKind.High) {
        return blend_alpha(warp_amount, MantlingHigh.MotionWarpingLocationBlendOption, MantlingHigh.MotionWarpingLocationCustomBlendCurve);
    }
    if (kind == AlsMantlingSettingsKind.HighInAir) {
        return blend_alpha(warp_amount, MantlingHighInAir.MotionWarpingLocationBlendOption, MantlingHighInAir.MotionWarpingLocationCustomBlendCurve);
    }
    if (kind == AlsMantlingSettingsKind.LowBox) {
        return blend_alpha(warp_amount, MantlingLowBox.MotionWarpingLocationBlendOption, MantlingLowBox.MotionWarpingLocationCustomBlendCurve);
    }
    return blend_alpha(warp_amount, MantlingLow.MotionWarpingLocationBlendOption, MantlingLow.MotionWarpingLocationCustomBlendCurve);
}

view mantling_rotation_warp(kind: AlsMantlingSettingsKind, warp_amount: float) -> float {       // RMS:74-78
    if (kind == AlsMantlingSettingsKind.High) {
        return blend_alpha(warp_amount, MantlingHigh.MotionWarpingRotationBlendOption, MantlingHigh.MotionWarpingRotationCustomBlendCurve);
    }
    if (kind == AlsMantlingSettingsKind.HighInAir) {
        return blend_alpha(warp_amount, MantlingHighInAir.MotionWarpingRotationBlendOption, MantlingHighInAir.MotionWarpingRotationCustomBlendCurve);
    }
    if (kind == AlsMantlingSettingsKind.LowBox) {
        return blend_alpha(warp_amount, MantlingLowBox.MotionWarpingRotationBlendOption, MantlingLowBox.MotionWarpingRotationCustomBlendCurve);
    }
    return blend_alpha(warp_amount, MantlingLow.MotionWarpingRotationBlendOption, MantlingLow.MotionWarpingRotationCustomBlendCurve);
}

// Character.GetBaseRotationOffset(): the rotation of the mesh relative to the actor (ACharacter caches the mesh's relative rotation).
view base_rotation_offset() -> quatd {                                           // CA:517 (ACharacter::GetBaseRotationOffset, an FQuat)
    return quat_inverse(ActorQuat) * MeshWorldTransform.rotation;
}

method start_mantling_implementation(parameters: AlsMantlingParameters) {        // CA:464-575
    let allowed = is_mantling_allowed_to_start();
    if (!allowed) { return; }                                                    // :466-469
    if (!host.primitive_valid(parameters.TargetPrimitive)) { return; }           // :471-476

    let kind = select_mantling_settings(parameters.MantlingType);                // :478
    let ms = mantling_settings_values(kind);
    if (!valid(ms.Montage)) { return; }                                      // :480-483 ALS_ENSURE(IsValid(MantlingSettings) && IsValid(Montage))

    // Reset network smoothing and the mesh offset (:485-492): not in DAL.

    // Clear the character movement mode and set the locomotion action to mantling.   :494
    host.set_movement_mode(MovementMode.Custom, 0);                              // :496
    apply_movement_mode(MovementMode.Custom);
    host.set_movement_mode_locked(true);                                         // :497
    host.set_movement_base(parameters.TargetPrimitive);                          // :499-500 SetBase(&MovementBaseData): the character is carried along with the target

    // Create mantling root motion.   :502
    var source = AlsMantlingRootMotionSource();                                  // :504
    source.Kind = kind;                                                          // :506
    source.Montage = ms.Montage;
    source.MotionWarpingTimeRange = ms.MotionWarpingTimeRange;
    source.TargetPrimitive = parameters.TargetPrimitive;                         // :507

    let start_time = calculate_mantling_start_time(kind, parameters.MantlingHeight);     // :509
    let duration = host.montage_length(ms.Montage) - start_time;             // :510
    let play_rate = host.montage_rate_scale(ms.Montage);                     // :511
    source.Duration = duration / play_rate;                                      // :513
    source.MontageStartTime = start_time;                                        // :514

    let use_target_primitive_space = host.primitive_uses_relative_location(parameters.TargetPrimitive);      // :515 MovementBaseUtility::UseRelativeLocation(&MovementBaseData)
    let mesh_rotation_offset = base_rotation_offset();                           // :517
    let mesh_transform = transformd(vec3d(0d, 0d, 0d), mesh_rotation_offset);    // FTransform MeshTransform{GetBaseRotationOffset()}
    source.MeshRotationOffset = mesh_rotation_offset;

    // Extract the initial root transform, invert it, convert it from component space to actor space, and apply it to the actor transform.   :519
    let actor_transform = transformd(ActorLocation, quatd(to_quat(ActorRotationNow)));   // :521
    let start_root_transform = with_scale(transformd(host.montage_root_transform(ms.Montage, start_time)), vec3d(1d, 1d, 1d));      // :523-524
    let start_root_transform_inverse = relative_transform_reverse(start_root_transform, mesh_transform);        // :526
    var start_transform = compose(start_root_transform_inverse, actor_transform);        // :527
    if (use_target_primitive_space) {                                            // :529
        // Convert the start transform to the target primitive space.
        start_transform = relative_transform(start_transform, host.primitive_transform(parameters.TargetPrimitive));      // :532 SetToRelativeTransform
    }
    source.StartRotation = to_rotator(start_transform.rotation);                 // :535
    source.StartLocation = start_transform.location;                             // :536

    // Extract the final root transform, invert it, convert it from component space to actor space, and apply it to the target transform.   :538
    var target_transform = transformd(parameters.TargetLocation, to_quat(normalize_rotator(parameters.TargetRotation)));      // :540
    if (use_target_primitive_space) {                                            // :542
        // Convert the relative target transform back to world space.
        target_transform = with_scale(compose(target_transform, host.primitive_transform(parameters.TargetPrimitive)), vec3d(1d, 1d, 1d));      // :545-546
    }
    let end_root_transform = with_scale(transformd(host.montage_last_root_transform(ms.Montage)), vec3d(1d, 1d, 1d));  // :549-550
    let end_root_transform_inverse = relative_transform_reverse(end_root_transform, mesh_transform);            // :552
    var new_target_transform = compose(end_root_transform_inverse, target_transform);   // :553
    if (use_target_primitive_space) {                                            // :555
        // Convert the target transform to be relative to the target primitive.
        new_target_transform = relative_transform(new_target_transform, host.primitive_transform(parameters.TargetPrimitive));      // :558
    }
    source.TargetRotation = to_rotator(new_target_transform.rotation);           // :561
    source.TargetLocation = new_target_transform.location;                       // :562

    // Apply root motion.   :564
    source.bActive = true;
    MantlingSource = source;
    MantlingSourceCount += 1;
    MantlingState.RootMotionSourceId = MantlingSourceCount;                      // :565 ApplyRootMotionSource
    host.root_motion_override(vec3d(0d, 0d, 0d), quatd(0d, 0d, 0d, 1d));         // the source is there from now on; its first step is prepared in the next one (prepare_root_motion)

    // Play the animation montage if valid.   :567
    host.montage_play(ms.Montage, 1.0);                                      // :569
    SetLocomotionAction(AlsLocomotionAction.Mantling);                           // :571
    // OnMantlingStarted(Parameters)                                             // :574 (Blueprint event)
}

method calculate_mantling_start_time(kind: AlsMantlingSettingsKind, mantling_height: float) -> float {      // CA:583-642
    let ms = mantling_settings_values(kind);
    if (!ms.bAutoCalculateStartTime) {                                       // :585
        return map_range_clamped(ms.StartTimeReferenceHeight.x, ms.StartTimeReferenceHeight.y, ms.StartTime.x, ms.StartTime.y, mantling_height);   // :587
    }

    // https://landelare.github.io/2022/05/15/climbing-with-root-motion.html

    if (!valid(ms.Montage)) { return 0.0; }                                  // :592-596

    let montage_frame_rate = 1.0 / host.montage_sampling_rate(ms.Montage);   // :598 (as written in ALS: the reciprocal of the sampling rate)

    var search_start_time = 0.0;                                                 // :600
    var search_end_time = host.montage_length(ms.Montage);                   // :601

    let search_start_location_z = host.montage_root_transform(ms.Montage, search_start_time).location.z;       // :603
    let search_end_location_z = host.montage_root_transform(ms.Montage, search_end_time).location.z;         // :604

    // Find the vertical distance the character has already moved.   :606
    let target_location_z = max(0.0, search_end_location_z - mantling_height);   // :608

    // Perform a binary search to find the time when the character is at the target vertical distance.   :610
    if (is_nearly_equal(search_start_location_z, target_location_z, 1.0)) {      // :612-617 MaxLocationSearchTolerance = 1
        return search_start_time;
    }

    var time = 0.0;
    for i in 0..32 {                                                             // :619 while (true): the interval halves every pass, 32 passes are far below any frame rate
        time = (search_start_time + search_end_time) * 0.5;                      // :621
        let location_z = host.montage_root_transform(ms.Montage, time).location.z;     // :622

        // Stop the search if a close enough location has been found or if the search interval is less than the animation montage frame rate.
        if (is_nearly_equal(location_z, target_location_z, 1.0) || search_end_time - search_start_time <= montage_frame_rate) {      // :627-628
            return time;                                                         // :630
        }

        if (location_z < target_location_z) {                                    // :633
            search_start_time = time;                                            // :635
        } else {
            search_end_time = time;                                              // :639
        }
    }
    return time;
}

method refresh_mantling() {                                                      // CA:646-679
    if (MantlingState.RootMotionSourceId <= 0) { return; }                       // :648-651

    if (LocomotionAction != AlsLocomotionAction.Mantling) {                      // :653
        stop_mantling(false);                                                    // :655
        return;
    }

    if (MovementModeNow != MovementMode.Custom) {                                // :659
        stop_mantling(true);                                                     // :661
        return;
    }

    if (MantlingSource.bActive && !host.primitive_valid(MantlingSource.TargetPrimitive)) {   // :665-670 (the source is gone once it finished)
        stop_mantling(true);                                                     // :672

        if (Settings.Mantling.bStartRagdollingOnTargetPrimitiveDestruction) {    // :674
            StartRagdolling();                                                   // :676
        }
    }
}

method stop_mantling(bStopMontage: bool) {                                       // CA:681-713
    if (MantlingState.RootMotionSourceId <= 0) { return; }                       // :683-686

    let source_exists = MantlingSource.bActive;                                  // :688-691 GetRootMotionSourceByID != nullptr
    host.root_motion_clear();                                                    // :695 Status.SetFlag(MarkedForRemoval)
    MantlingSource.bActive = false;
    MantlingSource.bClearPending = false;

    MantlingState.RootMotionSourceId = 0;                                        // :698

    if (bStopMontage && source_exists) {                                         // :700
        host.montage_stop(MantlingSource.Montage, Settings.Mantling.BlendOutDuration);       // :702
    }

    // NetworkSmoothingMode = Exponential                                        // :705
    host.set_movement_mode_locked(false);                                        // :707
    set_movement_mode_now(MovementMode.Walking);                                 // :708
    // OnMantlingEnded()                                                         // :710 (Blueprint event)
}

// FAlsRootMotionSource_Mantling::PrepareRootMotion.  The movement component calls it while it moves the character, with the time of its
// step: this runs in the prepare_root_motion block, which the movement component runs itself at that point (after the character has
// followed its movement base: the actor is where this step has put it, the target primitive where it is now).  The root motion override
// of the host stands in for the FRootMotionSource (Override accumulate mode: the translation is a velocity); it holds until
// root_motion_clear().
method prepare_mantling_root_motion(dt: float) {                                 // RMS:37-128
    if (!MantlingSource.bActive) { return; }

    MantlingSource.Time = min(MantlingSource.Time + dt, MantlingSource.Duration);     // :40 SetTime(GetTime() + SimulationDeltaTime): the source ends at its duration
    if (MantlingSource.Time >= MantlingSource.Duration) {
        MantlingSource.bActive = false;                                          // the last tick of the source: the movement component drops it afterwards
        MantlingSource.bClearPending = true;
    }

    if (!(MantlingSource.Duration > SMALL_NUMBER) || dt <= SMALL_NUMBER || !host.primitive_valid(MantlingSource.TargetPrimitive)) {    // :42
        host.root_motion_clear();                                                // :44 RootMotionParams.Clear()
        return;
    }

    let source_montage = MantlingSource.Montage;                                 // :48
    let montage_time = MantlingSource.MontageStartTime + MantlingSource.Time * host.montage_rate_scale(source_montage);       // :49

    // Synchronize the mantling animation montage's time with the mantling root motion source's time.
    // Delta time subtraction is necessary here, otherwise there will be a one frame lag between them.   :51-52
    host.montage_set_position(source_montage, max(0.0, montage_time - dt));      // :54

    var blend_in_amount = 1.0;                                                   // :56
    let montage_blend_in_time = host.montage_blend_in_time(source_montage);      // :57-59
    if (montage_blend_in_time > SMALL_NUMBER) {
        blend_in_amount = blend_alpha(MantlingSource.Time / montage_blend_in_time, host.montage_blend_in_option(source_montage),
                                      MantlingHigh.MotionWarpingLocationCustomBlendCurve);     // :61-63 (a custom blend-in curve of the montage is not readable: linear)
    }

    let warp_amount = clamp01(range_pct(MantlingSource.MotionWarpingTimeRange.Min, MantlingSource.MotionWarpingTimeRange.Max, montage_time));    // :66
    let location_warp_amount = blend_in_amount * mantling_location_warp(MantlingSource.Kind, warp_amount);     // :68-72
    let rotation_warp_amount = blend_in_amount * mantling_rotation_warp(MantlingSource.Kind, warp_amount);     // :74-78

    var start_transform = transformd(MantlingSource.StartLocation, to_quat(MantlingSource.StartRotation));     // :80
    var target_transform = transformd(MantlingSource.TargetLocation, to_quat(MantlingSource.TargetRotation));  // :81

    if (host.primitive_uses_relative_location(MantlingSource.TargetPrimitive)) {   // :84 MovementBaseUtility::UseRelativeLocation(&MovementBaseData)
        // Convert the start and target transforms from target primitive space to world space.
        let primitive_transform = host.primitive_transform(MantlingSource.TargetPrimitive);      // TargetPrimitive->GetComponentTransform()
        start_transform = with_scale(compose(start_transform, primitive_transform), vec3d(1d, 1d, 1d));         // :88-89
        target_transform = with_scale(compose(target_transform, primitive_transform), vec3d(1d, 1d, 1d));       // :91-92
    }

    // Interpolate the start and target transforms to obtain the warped transform.   :95
    let warp_location = lerp(start_transform.location, target_transform.location, location_warp_amount);       // :97
    let warp_rotation_lerp = normalize(fast_lerp(start_transform.rotation, target_transform.rotation, rotation_warp_amount));     // :99-100 (WarpRotation.Normalize())

    // Remove the pitch and roll components of the rotation so that the actor's Z axis is always aligned with the gravity direction.   :102
    let warp_rotation = get_twist(warp_rotation_lerp, vec3d(0d, 0d, 1d));        // :104 UAlsRotation::GetTwist(WarpRotation, -GetGravityDirection())
    let warp_transform = transformd(warp_location, warp_rotation);               // :106

    // Extract the current root transform and convert it from component space to actor space.   :108
    let root_transform_component = with_scale(transformd(host.montage_root_transform(source_montage, montage_time)), vec3d(1d, 1d, 1d));      // :110-111
    let mesh_transform = transformd(vec3d(0d, 0d, 0d), MantlingSource.MeshRotationOffset);      // :113
    let root_transform = relative_transform_reverse(mesh_transform, root_transform_component);   // :114 MeshTransform.GetRelativeTransformReverse(RootTransform)

    // Apply the current root transform to the warped transform to get the target actor transform.   :116
    let target_actor_transform = compose(root_transform, warp_transform);        // :118

    // Calculate the final root motion by taking the delta between the current actor transform and the target actor transform.   :120
    host.root_motion_override((target_actor_transform.location - ActorLocation) / dt,
                              target_actor_transform.rotation * quat_inverse(ActorQuat));       // :122-127 (all double: the velocity is (TargetActorTransform.GetLocation() - GetActorLocation()) / DeltaTime in FVector)
}

// ================================================================================================================================
// ragdolling (AlsCharacter_Actions.cpp:717-1170)
// ================================================================================================================================

struct AlsRagdollGroundTrace {                                                   // the (location, bGrounded) pair of RagdollTraceGround(bool& bGrounded)
    Location: vec3d;
    bGrounded: bool;
}

view is_ragdolling_allowed_to_start() -> bool {                                  // CA:717-724 (the physics asset must have the pelvis and spine_03 bodies: the host says so)
    return LocomotionAction != AlsLocomotionAction.Ragdolling && RagdollSupported;       // :719-723
}

pub method StartRagdolling() {                                                   // CA:726-757 (the role check and the RPCs are dropped)
    let allowed = is_ragdolling_allowed_to_start();
    if (!allowed) { return; }                                                    // :728
    start_ragdolling_implementation();                                           // :741, :756
}

method start_ragdolling_implementation() {                                       // CA:759-844
    let allowed = is_ragdolling_allowed_to_start();
    if (!allowed) { return; }                                                    // :761-764

    // bUpdateJointsFromAnimation, UpdateRBJointMotors (:766-771) and everything between :779 and :798 (network smoothing, detaching the
    // mesh, the capsule's collision, simulating physics, ResetAllBodiesSimulatePhysics): host.ragdoll_begin below.

    // Stop any active montages.   :773
    host.montage_stop_all(0.2);                                                  // :775-777 BlendOutDuration = 0.2

    // The pelvis body's location and velocity (:800-807): the ragdoll has not begun (the command runs after this block), so the pelvis bone
    // and the character's own velocity stand in for them until the first refresh, which reads the body.
    RagdollingState.Velocity = LocomotionState.Velocity;                         // :806
    RagdollingState.PullForce = 0.0;                                             // :809

    if (Settings.Ragdolling.bLimitInitialRagdollSpeed) {                         // :811
        // Limit the ragdoll's speed for a few frames, because for some unclear reason, it can get a much higher initial speed than the character's last speed.
        RagdollingState.SpeedLimitFrameTimeRemaining = 8;                        // :820
        RagdollingState.SpeedLimit = max(200.0, length(LocomotionState.Velocity));      // :818 MinSpeedLimit, :821
        // ConstraintRagdollSpeed() at once (:823): the service limits the speed in ragdoll_begin
    }
    host.ragdoll_begin(Settings.Ragdolling.bLimitInitialRagdollSpeed, RagdollingState.SpeedLimit);      // :766-798, :823

    RagdollTargetLocation = PelvisTransform.location;                            // :826-834 SetRagdollTargetLocation (the locally controlled branch)

    // Clear the character movement mode and set the locomotion action to ragdolling.   :836
    host.set_movement_mode(MovementMode.None);                                   // :838
    MovementModeNow = MovementMode.None;
    LocomotionMode = AlsLocomotionMode.None;                                     // C:469-491 at once.  Not through apply_movement_mode: its notification can start a ragdoll
                                                                                 // (C:512-516) and DAL has no recursion; a locomotion mode of None has nothing to notify.
    host.set_movement_mode_locked(true);                                         // :839

    SetLocomotionAction(AlsLocomotionAction.Ragdolling);                         // :841

    // OnRagdollingStarted()                                                     // :843 (Blueprint event)
}

method refresh_ragdolling(dt: float) {                                           // CA:868-961
    if (LocomotionAction != AlsLocomotionAction.Ragdolling) { return; }          // :870-873

    // The pelvis body (:875-885): its location and linear velocity, read off the physics body (not the bone: the bones lag behind the simulation).
    let pelvis_location = RagdollPelvisLocation;                                 // :883
    RagdollingState.Velocity = RagdollVelocity;                                  // :884

    // bLocallyControlled is always true (:887)
    RagdollTargetLocation = pelvis_location;                                     // :889-892 SetRagdollTargetLocation(PelvisLocation)

    // Prevent the capsule from going through the ground when the ragdoll is lying on the ground.   :894
    // While we could get rid of the line trace here and just use RagdollTargetLocation as the character's location, we don't do that
    // because the camera depends on the capsule's bottom location, so its removal will cause the camera to behave erratically.
    let ground = ragdoll_trace_ground();                                         // :900
    host.set_actor_location(ground.Location, false, true);                       // :901 SetActorLocation(.., false, nullptr, ETeleportType::TeleportPhysics)

    // The pull force that corrects a ragdoll that is not locally controlled (:903-942) is a network feature: dropped.

    // Use the speed to scale ragdoll joint strength for physical animation.   :944
    let speed_amount = clamp01(length(RagdollingState.Velocity) / 1000.0);       // :946, :949 ReferenceSpeed
    host.ragdoll_set_motor_strength(speed_amount * 25000.0);                     // :947, :951 Stiffness

    // Limit the speed of ragdoll bodies.   :953
    if (RagdollingState.SpeedLimitFrameTimeRemaining > 0) {                      // :955
        RagdollingState.SpeedLimitFrameTimeRemaining -= 1;                       // :957
        host.ragdoll_limit_speed(RagdollingState.SpeedLimit);                    // :959 ConstraintRagdollSpeed()
    }
}

method ragdoll_trace_ground() -> AlsRagdollGroundTrace {                         // CA:963-999 RagdollTraceGround
    let target_is_set = RagdollTargetLocation.x != 0.0 || RagdollTargetLocation.y != 0.0 || RagdollTargetLocation.z != 0.0;      // :965 !RagdollTargetLocation.IsZero()
    let ragdoll_location = target_is_set ? RagdollTargetLocation : ActorLocation;       // (FVector)

    // We use a sphere sweep instead of a simple line trace to keep capsule movement consistent between ragdolling and regular character movement.   :967
    let trace_start = vec3d(ragdoll_location.x, ragdoll_location.y, ragdoll_location.z + 2.0 * CapsuleRadius);                // :973
    let trace_end = vec3d(ragdoll_location.x, ragdoll_location.y, ragdoll_location.z - CapsuleHalfHeight + CapsuleRadius);    // :974

    // The collision channel of the capsule is ECC_Pawn; the responses are the capsule's (InitCollisionParams): what blocks mantling blocks it.   :976-980
    let ground_hit = host.sweep_sphere(trace_start, trace_end, CapsuleRadius, Channel.Pawn, Settings.Mantling.MantlingTraceResponses);       // :983-985

    return AlsRagdollGroundTrace(Location: vec3d(ragdoll_location.x, ragdoll_location.y,
                                                 ground_hit.blocking ? ground_hit.location_d.z + CapsuleHalfHeight - CapsuleRadius + MIN_FLOOR_DIST : ragdoll_location.z),
                                 bGrounded: ground_hit.blocking);                       // :993-998
}

view is_ragdolling_allowed_to_stop() -> bool {                                   // CA:1026-1029
    return LocomotionAction == AlsLocomotionAction.Ragdolling;                   // :1028
}

pub method StopRagdolling() -> bool {                                            // CA:1031-1048 (the role check and the RPCs are dropped)
    let allowed = is_ragdolling_allowed_to_stop();
    if (!allowed) { return false; }                                              // :1033-1036
    stop_ragdolling_implementation();                                            // :1040, :1061
    return true;                                                                 // :1047
}

method stop_ragdolling_implementation() {                                        // CA:1064-1165
    let allowed = is_ragdolling_allowed_to_stop();
    if (!allowed) { return; }                                                    // :1066-1069
    if (!valid(Anim)) { return; }                                                // :1071 (the animation instance has to be there to take the pose)

    // The final pose: the animation instance takes the snapshot (queued, it runs in the animation update of this tick, SnapshotPose command).
    // The host keeps the pose of the ragdoll that ragdoll_end ends until then (the pelvis fix of :1128-1138 is its part).
    Anim.SnapshotFinalRagdollPose();                                             // :1076

    let pelvis_rotation = to_rotator(PelvisTransform.rotation);                  // :1078-1079 (its yaw turns the actor; whether it lies face up the ragdoll service says)

    // Disable mesh physics simulation and enable capsule collision.   :1081 (host.ragdoll_end below: the actor is moved first, the service then
    // attaches the mesh to the capsule where it is and puts the pelvis of the final pose where it was, :1100-1138)
    let ground = ragdoll_trace_ground();                                         // :1094-1095

    // Determine whether the ragdoll is facing upward or downward and set the actor rotation accordingly.   :1097
    let ragdoll_facing_upward = RagdollFacingUp;                                 // :1099 UnwindDegrees(PelvisRotation.Roll) <= 0.0f

    var new_actor_rotation = ActorRotationNow;                                   // :1101
    new_actor_rotation.yaw = ragdoll_facing_upward ? pelvis_rotation.yaw - 180.0 : pelvis_rotation.yaw;       // :1102

    host.set_actor_location(ground.Location, false, true);                       // :1104 SetActorLocationAndRotation(.., false, nullptr, ETeleportType::TeleportPhysics)
    set_actor_rotation_now(new_actor_rotation, true);

    // Mesh physics simulation off, capsule collision on (:1081-1092), the mesh attached back to the moved capsule at its default relative
    // location (:1106-1126), the pelvis transform of the final pose restored (:1128-1138): the host's ragdoll service.
    host.ragdoll_end();

    // If the ragdoll is on the ground, set the movement mode to walking and play a get up montage. If not, set the movement mode to
    // falling and update the character movement velocity to match the last ragdoll velocity.   :1140
    host.set_movement_mode_locked(false);                                        // :1143

    if (ground.bGrounded) {                                                      // :1145
        set_movement_mode_now(MovementMode.Walking);                             // :1147
    } else {
        set_movement_mode_now(MovementMode.Falling);                             // :1151
        host.set_velocity(RagdollingState.Velocity);                             // :1152
    }

    SetLocomotionAction(AlsLocomotionAction.None);                               // :1155 FGameplayTag::EmptyTag

    // OnRagdollingEnded()                                                       // :1157 (Blueprint event)

    if (ground.bGrounded) {                                                      // :1159
        let get_up_montage = select_get_up_montage(ragdoll_facing_upward);
        if (valid(get_up_montage)) {                                             // Montage_Play(..) > 0
            host.montage_play(get_up_montage, 1.0);                              // :1159
            host.set_input_blocked(true);                                        // :1161 AlsCharacterMovement->SetInputBlocked(true)
            SetLocomotionAction(AlsLocomotionAction.GettingUp);                  // :1163 (the SetLocomotionAction notify state of the montage ends it)
        }
    }
}

method select_get_up_montage(bRagdollFacingUpward: bool) -> montage {            // CA:1167-1170 SelectGetUpMontage_Implementation
    if (bRagdollFacingUpward) {
        return Settings.Ragdolling.GetUpBackMontage;                             // :1169
    }
    return Settings.Ragdolling.GetUpFrontMontage;                                // :1169
}

// ================================================================================================================================
// the notify states the actions end on (Notifies/*.cpp).  The declared names are the C++ class names without the U, so the host finds
// the notify of a montage by its class; `branching` is bIsNativeBranchingPoint.
// ================================================================================================================================

notify_state AlsAnimNotifyState_SetLocomotionAction cpp "AlsAnimNotifyState_SetLocomotionAction" branching {     // Notifies/AlsAnimNotifyState_SetLocomotionAction.h:8-16
    LocomotionAction: AlsLocomotionAction;
}

on notify_begin AlsAnimNotifyState_SetLocomotionAction {                         // Notifies/AlsAnimNotifyState_SetLocomotionAction.cpp:25-33 NotifyBegin
    SetLocomotionAction(payload.LocomotionAction);                               // :31
}

on notify_end AlsAnimNotifyState_SetLocomotionAction {                           // Notifies/AlsAnimNotifyState_SetLocomotionAction.cpp:36-48 NotifyEnd
    if (LocomotionAction == payload.LocomotionAction) {                          // :44
        SetLocomotionAction(AlsLocomotionAction.None);                           // :46 FGameplayTag::EmptyTag
    }
}

notify_state AlsAnimNotifyState_SetRootMotionScale cpp "AlsAnimNotifyState_SetRootMotionScale" {                 // Notifies/AlsAnimNotifyState_SetRootMotionScale.h:7-15
    TranslationScale: float = 1.0;
}

on notify_begin AlsAnimNotifyState_SetRootMotionScale {                          // Notifies/AlsAnimNotifyState_SetRootMotionScale.cpp:30-40 NotifyBegin
    AnimRootMotionTranslationScale = payload.TranslationScale;
    host.set_anim_root_motion_translation_scale(payload.TranslationScale);       // :38 (the role check :36 is always true)
}

on notify_end AlsAnimNotifyState_SetRootMotionScale {                            // Notifies/AlsAnimNotifyState_SetRootMotionScale.cpp:43-62 NotifyEnd
    if (is_nearly_equal(AnimRootMotionTranslationScale, payload.TranslationScale)) {         // :52
        AnimRootMotionTranslationScale = 1.0;
        host.set_anim_root_motion_translation_scale(1.0);                        // :54
    }                                                                            // else: something changed the scale before the notify ended (:58, a warning in ALS)
}

notify_state AlsAnimNotifyState_EarlyBlendOut cpp "AlsAnimNotifyState_EarlyBlendOut" branching {                 // Notifies/AlsAnimNotifyState_EarlyBlendOut.h:8-40
    BlendOutDuration: float = 0.25;
    bCheckInput: bool = true;
    bCheckLocomotionMode: bool = true;
    bCheckRotationMode: bool = true;
    bCheckStance: bool = true;
    LocomotionModeEquals: AlsLocomotionMode = AlsLocomotionMode.InAir;
    RotationModeEquals: AlsRotationMode = AlsRotationMode.Aiming;
    StanceEquals: AlsStance = AlsStance.Crouching;
}

on notify_tick AlsAnimNotifyState_EarlyBlendOut {                                // Notifies/AlsAnimNotifyState_EarlyBlendOut.cpp:35-63 BranchingPointNotifyTick
    if ((payload.bCheckInput && LocomotionState.bHasInput)
        || (payload.bCheckLocomotionMode && LocomotionMode == payload.LocomotionModeEquals)
        || (payload.bCheckRotationMode && RotationMode == payload.RotationModeEquals)
        || (payload.bCheckStance && Stance == payload.StanceEquals)) {           // :43-47
        // Montage_Stop with the blend out settings of the montage and BlendOutDuration for the montage instance of the notify.   :49-61
        host.montage_stop_source(payload.BlendOutDuration);                      // :61 MontageInstance->Stop(BlendOutSettings)
    }
}
